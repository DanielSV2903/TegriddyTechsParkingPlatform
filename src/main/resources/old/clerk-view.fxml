<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>

<BorderPane style="-fx-background-color: linear-gradient(to bottom, #f7f9fc, #eef2f7);" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.tegriddytechs.parkingplatform.tegriddytechsparkingplatform.view.MainMenuController">
    <top>
        <VBox alignment="CENTER" spacing="6.0" style="-fx-background-color: linear-gradient(to right, #1f2d3a, #253847); -fx-padding: 18 20;">
            <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: white;" text="TegriddyTechs Parking Platform" />
            <Label prefHeight="19.0" prefWidth="199.0" style="-fx-font-size: 13px; -fx-text-fill: #c9d6e2;" text="Tablero de pruebas CRUD" textAlignment="CENTER" />
            <Button mnemonicParsing="false" onAction="#logOut" text="Log-Out" />
        </VBox>
    </top>
    <center>
        <TilePane hgap="16.0" prefColumns="3" style="-fx-padding: 20 28 28 28;" vgap="16.0">
            <padding>
                <Insets bottom="28.0" left="28.0" right="28.0" top="20.0" />
            </padding>

            <Button onAction="#openCrud" style="-fx-background-color: #ffffff; -fx-border-color: #c3ceda; -fx-border-radius: 12; -fx-background-radius: 12; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 18 24;" text="Clientes" userData="Clientes" />
            <Button onAction="#openCrud" style="-fx-background-color: #ffffff; -fx-border-color: #c3ceda; -fx-border-radius: 12; -fx-background-radius: 12; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 18 24;" text="Parqueaderos" userData="Parqueaderos" />
            <Button onAction="#openCrud" style="-fx-background-color: #ffffff; -fx-border-color: #c3ceda; -fx-border-radius: 12; -fx-background-radius: 12; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 18 24;" text="Vehiculos" userData="Vehiculos" />
            <Button onAction="#openCrud" style="-fx-background-color: #ffffff; -fx-border-color: #c3ceda; -fx-border-radius: 12; -fx-background-radius: 12; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 18 24;" text="Tickets" userData="Tickets" />
        </TilePane>
    </center>
</BorderPane>
