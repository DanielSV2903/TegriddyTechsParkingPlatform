<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.tegriddytechs.parkingplatform.tegriddytechsparkingplatform.view.VehicleCrudController">

    <top>
        <Label text="CRUD Vehículos"
               BorderPane.alignment="CENTER"
               style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 12 0;" />
    </top>

    <center>
        <GridPane hgap="10" vgap="10" style="-fx-padding: 12 20 10 20;">
            <columnConstraints>
                <ColumnConstraints minWidth="140"/>
                <ColumnConstraints minWidth="220"/>
            </columnConstraints>

            <children>

                <Label text="Placa"
                       GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="tfPlate"
                           GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Cliente"
                       GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <ComboBox fx:id="cbCustomer"
                          GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Tipo de vehículo"
                       GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <ComboBox fx:id="cbVehicleType"
                          GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <Label text="Estado"
                       GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <ComboBox fx:id="cbStatus"
                          GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                <Label text="Permiso discapacidad"
                       GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                <CheckBox fx:id="cbDisabled"
                          GridPane.rowIndex="4" GridPane.columnIndex="1"/>

            </children>
        </GridPane>
    </center>

    <bottom>
        <HBox spacing="10"
              alignment="CENTER"
              BorderPane.alignment="CENTER"
              style="-fx-padding: 10 0 16 0;">
            <children>
                <Button text="Crear" onAction="#onCreate"/>
                <Button text="Consultar" onAction="#onRead"/>
                <Button text="Actualizar" onAction="#onUpdate"/>
                <Button text="Eliminar" onAction="#onDelete"/>
            </children>
        </HBox>
    </bottom>

</BorderPane>
