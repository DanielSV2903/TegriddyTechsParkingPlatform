<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.tegriddytechs.parkingplatform.tegriddytechsparkingplatform.view.LoginController"
            style="-fx-background-color: linear-gradient(to bottom, #f7f9fc, #eef2f7);">

    <top>
        <VBox alignment="CENTER"
              style="-fx-background-color: linear-gradient(to right, #1f2d3a, #253847); -fx-padding: 20;">
            <Label text="TegriddyTechs Parking Platform"
                   style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: bold;"/>
            <Label text="Inicio de Sesión"
                   style="-fx-text-fill: #c9d6e2; -fx-font-size: 13px;"/>
        </VBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="14"
              style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 30; -fx-border-color: #d6dee8; -fx-border-radius: 16;"
              maxWidth="360">
            <padding>
                <Insets top="30"/>
            </padding>

            <Label text="Usuario"
                   style="-fx-font-size: 13px; -fx-font-weight: bold;"/>

            <TextField fx:id="txtUsername"
                       promptText="Ingrese su usuario"
                       style="-fx-background-radius: 10; -fx-padding: 10;"/>

            <Label text="Contraseña"
                   style="-fx-font-size: 13px; -fx-font-weight: bold;"/>

            <PasswordField fx:id="txtPassword"
                           promptText="Ingrese su contraseña"
                           style="-fx-background-radius: 10; -fx-padding: 10;"/>

            <Button text="Ingresar"
                    onAction="#login"
                    style="-fx-background-color: #253847; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 12; -fx-padding: 10 24;"/>

            <Label fx:id="lblMessage"
                   text=""
                   style="-fx-text-fill: #c0392b; -fx-font-size: 12px;"/>
        </VBox>
    </center>

</BorderPane>
