<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.tegriddytechs.parkingplatform.tegriddytechsparkingplatform.view.ParkingSpaceCrudController"
            style="-fx-background-color: #f0f4f8;">

    <top>
        <VBox style="-fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
            <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-padding: 20 28;">
                <HBox alignment="CENTER_LEFT" spacing="14">
                    <StackPane>
                        <Circle radius="24" fill="#38a169"/>
                        <SVGPath content="M -6,0 L 0,-6 L 6,0 L 0,6 Z"
                                 fill="transparent" stroke="white" strokeWidth="1.8"/>
                    </StackPane>
                    <VBox spacing="2">
                        <Label text="Gestión de Espacios"
                               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2d3748;"/>
                        <Label text="Administra los espacios de estacionamiento"
                               style="-fx-font-size: 12px; -fx-text-fill: #718096;"/>
                    </VBox>
                </HBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Regresar al Menú" onAction="#goBack"
                        style="-fx-background-color: #f7fafc; -fx-text-fill: #38a169; -fx-font-size: 13px; -fx-font-weight: 600; -fx-background-radius: 8; -fx-padding: 10 20; -fx-cursor: hand; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-border-width: 1;"/>
            </HBox>
            <Separator style="-fx-background-color: #e2e8f0;"/>
        </VBox>
    </top>

    <center>
        <HBox spacing="24" style="-fx-padding: 24 28;">
            <!-- Formulario izquierdo -->
            <VBox spacing="20" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 24; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);" prefWidth="380">
                <Label text="Datos del Espacio"
                       style="-fx-font-size: 16px; -fx-font-weight: 600; -fx-text-fill: #2d3748;"/>

                <VBox spacing="16">
                    <VBox spacing="6">
                        <Label text="ID Espacio"
                               style="-fx-font-size: 13px; -fx-font-weight: 500; -fx-text-fill: #4a5568;"/>
                        <TextField fx:id="tfSpaceId"
                                   style="-fx-background-color: #f7fafc; -fx-background-radius: 8; -fx-border-color: #cbd5e0; -fx-border-radius: 8; -fx-border-width: 1.5; -fx-padding: 12 14; -fx-font-size: 13px; -fx-text-fill: #2d3748;"
                                   prefHeight="42"/>
                    </VBox>

                    <VBox spacing="6">
                        <Label text="ID Parqueadero"
                               style="-fx-font-size: 13px; -fx-font-weight: 500; -fx-text-fill: #4a5568;"/>
                        <TextField fx:id="tfParkingLotId"
                                   style="-fx-background-color: #f7fafc; -fx-background-radius: 8; -fx-border-color: #cbd5e0; -fx-border-radius: 8; -fx-border-width: 1.5; -fx-padding: 12 14; -fx-font-size: 13px; -fx-text-fill: #2d3748;"
                                   prefHeight="42"/>
                    </VBox>

                    <VBox spacing="6">
                        <Label text="Tipo de Espacio"
                               style="-fx-font-size: 13px; -fx-font-weight: 500; -fx-text-fill: #4a5568;"/>
                        <ComboBox fx:id="cbSpaceType"
                                  style="-fx-background-color: #f7fafc; -fx-background-radius: 8; -fx-border-color: #cbd5e0; -fx-border-radius: 8; -fx-border-width: 1.5; -fx-padding: 8 14; -fx-font-size: 13px;"
                                  prefHeight="42" maxWidth="Infinity"/>
                    </VBox>

                    <VBox spacing="6">
                        <Label text="Estado"
                               style="-fx-font-size: 13px; -fx-font-weight: 500; -fx-text-fill: #4a5568;"/>
                        <ComboBox fx:id="cbStatus"
                                  style="-fx-background-color: #f7fafc; -fx-background-radius: 8; -fx-border-color: #cbd5e0; -fx-border-radius: 8; -fx-border-width: 1.5; -fx-padding: 8 14; -fx-font-size: 13px;"
                                  prefHeight="42" maxWidth="Infinity"/>
                    </VBox>
                </VBox>

                <VBox spacing="12" style="-fx-padding: 20 0 0 0;">
                    <Button text="Crear Espacio" onAction="#onCreate"
                            style="-fx-background-color: #48bb78; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: 600; -fx-background-radius: 8; -fx-padding: 14; -fx-cursor: hand;"
                            maxWidth="Infinity"/>
                    <Button text="Actualizar Espacio" onAction="#onUpdate"
                            style="-fx-background-color: #4299e1; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: 600; -fx-background-radius: 8; -fx-padding: 14; -fx-cursor: hand;"
                            maxWidth="Infinity"/>
                    <Button text="Eliminar Espacio" onAction="#onDelete"
                            style="-fx-background-color: #f56565; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: 600; -fx-background-radius: 8; -fx-padding: 14; -fx-cursor: hand;"
                            maxWidth="Infinity"/>
                    <Button text="Limpiar Formulario" onAction="#onClear"
                            style="-fx-background-color: #f7fafc; -fx-text-fill: #4a5568; -fx-font-size: 13px; -fx-font-weight: 600; -fx-background-radius: 8; -fx-padding: 14; -fx-cursor: hand; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-border-width: 1;"
                            maxWidth="Infinity"/>
                </VBox>
            </VBox>

            <!-- Tabla derecha -->
            <VBox spacing="16" style="-fx-pref-width: 700;">
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label text="Lista de Espacios"
                           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2d3748;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <TextField fx:id="tfSearch" promptText="Buscar por ID o tipo..."
                               style="-fx-background-color: #f7fafc; -fx-background-radius: 8; -fx-border-color: #cbd5e0; -fx-border-radius: 8; -fx-border-width: 1.5; -fx-padding: 10 14; -fx-font-size: 13px; -fx-text-fill: #2d3748;"
                               prefHeight="38" prefWidth="240"/>
                    <Button text="Actualizar Tabla" onAction="#onRefresh"
                            style="-fx-background-color: #f7fafc; -fx-text-fill: #38a169; -fx-font-size: 13px; -fx-font-weight: 600; -fx-background-radius: 8; -fx-padding: 10 20; -fx-cursor: hand; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-border-width: 1;"/>
                </HBox>

                <TableView fx:id="tableSpaces"
                           style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">
                    <columns>
                        <TableColumn fx:id="colSpaceId" text="ID Espacio" prefWidth="100"/>
                        <TableColumn fx:id="colParkingLotId" text="ID Parqueadero" prefWidth="120"/>
                        <TableColumn fx:id="colSpaceType" text="Tipo" prefWidth="120"/>
                        <TableColumn fx:id="colStatus" text="Estado" prefWidth="100"/>
                    </columns>
                </TableView>

                <HBox alignment="CENTER_LEFT">
                    <Label fx:id="lblTotalRecords" text="Total: 0 registros"
                           style="-fx-font-size: 13px; -fx-text-fill: #718096;"/>
                </HBox>
            </VBox>
        </HBox>
    </center>
</BorderPane>