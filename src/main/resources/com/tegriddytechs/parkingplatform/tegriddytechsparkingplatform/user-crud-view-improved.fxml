<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane xmlns="http://javafx.com/javafx/21" 
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.tegriddytechs.parkingplatform.tegriddytechsparkingplatform.view.UserCrudController"
            style="-fx-background-color: #f0f4f8;">

    <!-- Barra Superior -->
    <top>
        <VBox style="-fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
            <HBox alignment="CENTER_LEFT" spacing="16" style="-fx-padding: 18 24;">
                <Circle radius="8" style="-fx-fill: #3182ce;"/>
                <Label text="Gestión de Usuarios"
                       style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2d3748;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="← Volver" 
                        onAction="#goBack"
                        style="-fx-background-color: #edf2f7; 
                               -fx-text-fill: #4a5568; 
                               -fx-font-size: 13px;
                               -fx-font-weight: 600;
                               -fx-background-radius: 8; 
                               -fx-padding: 10 20;
                               -fx-cursor: hand;"/>
            </HBox>
            <Separator style="-fx-background-color: #e2e8f0;"/>
        </VBox>
    </top>

    <center>
        <HBox spacing="0" style="-fx-background-color: #f0f4f8;">
            
            <!-- Panel Izquierdo: Formulario -->
            <VBox spacing="0" style="-fx-pref-width: 420; -fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 2, 0);">
                <VBox spacing="20" style="-fx-padding: 24;">
                    
                    <!-- Título del Formulario -->
                    <VBox spacing="8">
                        <Label text="Formulario de Usuario"
                               style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2d3748;"/>
                        <Label text="Complete los campos para crear o editar un usuario"
                               style="-fx-font-size: 12px; -fx-text-fill: #718096; -fx-wrap-text: true;"/>
                    </VBox>
                    
                    <Separator style="-fx-background-color: #e2e8f0;"/>
                    
                    <!-- Contenedor con Scroll -->
                    <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent;">
                        <VBox spacing="20" style="-fx-padding: 4 2;">
                            
                            <!-- Campo ID -->
                            <VBox spacing="8">
                                <Label text="ID del Usuario"
                                       style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #4a5568;"/>
                                <TextField fx:id="tfId"
                                          promptText="Ingrese el ID (numérico)"
                                          style="-fx-background-color: #f7fafc; 
                                                 -fx-background-radius: 8; 
                                                 -fx-border-color: #cbd5e0; 
                                                 -fx-border-radius: 8; 
                                                 -fx-border-width: 1.5;
                                                 -fx-padding: 12 14;
                                                 -fx-font-size: 13px;
                                                 -fx-text-fill: #2d3748;"
                                          prefHeight="42"/>
                            </VBox>
                            
                            <!-- Campo Nombre -->
                            <VBox spacing="8">
                                <Label text="Nombre Completo"
                                       style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #4a5568;"/>
                                <TextField fx:id="tfName"
                                          promptText="Ingrese el nombre completo"
                                          style="-fx-background-color: #f7fafc; 
                                                 -fx-background-radius: 8; 
                                                 -fx-border-color: #cbd5e0; 
                                                 -fx-border-radius: 8; 
                                                 -fx-border-width: 1.5;
                                                 -fx-padding: 12 14;
                                                 -fx-font-size: 13px;
                                                 -fx-text-fill: #2d3748;"
                                          prefHeight="42"/>
                            </VBox>
                            
                            <!-- Campo Username -->
                            <VBox spacing="8">
                                <Label text="Nombre de Usuario"
                                       style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #4a5568;"/>
                                <TextField fx:id="tfUsername"
                                          promptText="Ingrese el nombre de usuario"
                                          style="-fx-background-color: #f7fafc; 
                                                 -fx-background-radius: 8; 
                                                 -fx-border-color: #cbd5e0; 
                                                 -fx-border-radius: 8; 
                                                 -fx-border-width: 1.5;
                                                 -fx-padding: 12 14;
                                                 -fx-font-size: 13px;
                                                 -fx-text-fill: #2d3748;"
                                          prefHeight="42"/>
                            </VBox>
                            
                            <!-- Campo Password -->
                            <VBox spacing="8">
                                <Label text="Contraseña"
                                       style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #4a5568;"/>
                                <PasswordField fx:id="tfPassword"
                                              promptText="Ingrese la contraseña"
                                              style="-fx-background-color: #f7fafc; 
                                                     -fx-background-radius: 8; 
                                                     -fx-border-color: #cbd5e0; 
                                                     -fx-border-radius: 8; 
                                                     -fx-border-width: 1.5;
                                                     -fx-padding: 12 14;
                                                     -fx-font-size: 13px;
                                                     -fx-text-fill: #2d3748;"
                                              prefHeight="42"/>
                            </VBox>
                            
                            <!-- Campo Rol -->
                            <VBox spacing="8">
                                <Label text="Rol del Usuario"
                                       style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #4a5568;"/>
                                <ComboBox fx:id="cbRole"
                                         promptText="Seleccione el rol"
                                         maxWidth="Infinity"
                                         style="-fx-background-color: #f7fafc; 
                                                -fx-background-radius: 8; 
                                                -fx-border-color: #cbd5e0; 
                                                -fx-border-radius: 8; 
                                                -fx-border-width: 1.5;
                                                -fx-padding: 8 14;
                                                -fx-font-size: 13px;
                                                -fx-text-fill: #2d3748;"
                                         prefHeight="42"/>
                            </VBox>
                            
                        </VBox>
                    </ScrollPane>
                    
                    <!-- Botones de Acción -->
                    <VBox spacing="12" style="-fx-padding: 8 0 0 0;">
                        <Button text="✓ Crear Usuario" 
                                onAction="#onCreate"
                                maxWidth="Infinity"
                                style="-fx-background-color: linear-gradient(135deg, #48bb78 0%, #38a169 100%); 
                                       -fx-text-fill: white; 
                                       -fx-font-size: 14px;
                                       -fx-font-weight: 600;
                                       -fx-background-radius: 8; 
                                       -fx-padding: 14;
                                       -fx-cursor: hand;
                                       -fx-effect: dropshadow(gaussian, rgba(72, 187, 120, 0.3), 8, 0, 0, 3);"/>
                        
                        <HBox spacing="10">
                            <Button text="↻ Actualizar" 
                                    onAction="#onUpdate"
                                    HBox.hgrow="ALWAYS"
                                    maxWidth="Infinity"
                                    style="-fx-background-color: linear-gradient(135deg, #4299e1 0%, #3182ce 100%); 
                                           -fx-text-fill: white; 
                                           -fx-font-size: 13px;
                                           -fx-font-weight: 600;
                                           -fx-background-radius: 8; 
                                           -fx-padding: 12;
                                           -fx-cursor: hand;"/>
                            
                            <Button text="🗑 Eliminar" 
                                    onAction="#onDelete"
                                    HBox.hgrow="ALWAYS"
                                    maxWidth="Infinity"
                                    style="-fx-background-color: linear-gradient(135deg, #fc8181 0%, #e53e3e 100%); 
                                           -fx-text-fill: white; 
                                           -fx-font-size: 13px;
                                           -fx-font-weight: 600;
                                           -fx-background-radius: 8; 
                                           -fx-padding: 12;
                                           -fx-cursor: hand;"/>
                        </HBox>
                        
                        <Button text="⟲ Limpiar Formulario" 
                                onAction="#onClear"
                                maxWidth="Infinity"
                                style="-fx-background-color: #edf2f7; 
                                       -fx-text-fill: #4a5568; 
                                       -fx-font-size: 13px;
                                       -fx-font-weight: 600;
                                       -fx-background-radius: 8; 
                                       -fx-padding: 12;
                                       -fx-cursor: hand;
                                       -fx-border-color: #cbd5e0;
                                       -fx-border-radius: 8;
                                       -fx-border-width: 1.5;"/>
                    </VBox>
                    
                </VBox>
            </VBox>
            
            <!-- Panel Derecho: Lista/Tabla -->
            <VBox spacing="0" HBox.hgrow="ALWAYS" style="-fx-background-color: #f0f4f8;">
                <VBox spacing="20" style="-fx-padding: 24;">
                    
                    <!-- Barra de Búsqueda y Acciones -->
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Lista de Usuarios"
                                   style="-fx-font-size: 16px; -fx-font-weight: 600; -fx-text-fill: #2d3748;"/>
                            <Label text="Busque y seleccione usuarios para editarlos"
                                   style="-fx-font-size: 12px; -fx-text-fill: #718096;"/>
                        </VBox>
                        
                        <TextField fx:id="tfSearch"
                                  promptText="🔍 Buscar por ID, nombre o usuario..."
                                  style="-fx-background-color: white; 
                                         -fx-background-radius: 8; 
                                         -fx-border-color: #cbd5e0; 
                                         -fx-border-radius: 8; 
                                         -fx-border-width: 1.5;
                                         -fx-padding: 10 14;
                                         -fx-font-size: 13px;
                                         -fx-pref-width: 320;"
                                  prefHeight="40"/>
                        
                        <Button text="↻ Refrescar" 
                                onAction="#onRefresh"
                                style="-fx-background-color: white; 
                                       -fx-text-fill: #4a5568; 
                                       -fx-font-size: 13px;
                                       -fx-font-weight: 600;
                                       -fx-background-radius: 8; 
                                       -fx-padding: 10 20;
                                       -fx-cursor: hand;
                                       -fx-border-color: #cbd5e0;
                                       -fx-border-radius: 8;
                                       -fx-border-width: 1.5;"/>
                    </HBox>
                    
                    <!-- Tabla de Usuarios -->
                    <TableView fx:id="tableUsers" 
                              VBox.vgrow="ALWAYS"
                              style="-fx-background-color: white; 
                                     -fx-background-radius: 12; 
                                     -fx-border-color: #e2e8f0;
                                     -fx-border-radius: 12;
                                     -fx-border-width: 1;
                                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 6, 0, 0, 2);">
                        <columns>
                            <TableColumn text="ID" 
                                        fx:id="colId"
                                        prefWidth="80"
                                        style="-fx-alignment: CENTER;"/>
                            <TableColumn text="Nombre Completo" 
                                        fx:id="colName"
                                        prefWidth="250"
                                        style="-fx-alignment: CENTER_LEFT;"/>
                            <TableColumn text="Usuario" 
                                        fx:id="colUsername"
                                        prefWidth="200"
                                        style="-fx-alignment: CENTER_LEFT;"/>
                            <TableColumn text="Rol" 
                                        fx:id="colRole"
                                        prefWidth="150"
                                        style="-fx-alignment: CENTER;"/>
                        </columns>
                        <placeholder>
                            <VBox alignment="CENTER" spacing="12" style="-fx-padding: 40;">
                                <Label text="📋" style="-fx-font-size: 48px;"/>
                                <Label text="No hay usuarios registrados"
                                       style="-fx-font-size: 16px; -fx-font-weight: 600; -fx-text-fill: #4a5568;"/>
                                <Label text="Cree un nuevo usuario usando el formulario"
                                       style="-fx-font-size: 13px; -fx-text-fill: #718096;"/>
                            </VBox>
                        </placeholder>
                    </TableView>
                    
                    <!-- Información de Registros -->
                    <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 8 0 0 0;">
                        <Label text="Total de registros:"
                               style="-fx-font-size: 12px; -fx-text-fill: #718096;"/>
                        <Label fx:id="lblTotalRecords" 
                               text="0"
                               style="-fx-font-size: 12px; -fx-font-weight: 700; -fx-text-fill: #2d3748;"/>
                    </HBox>
                    
                </VBox>
            </VBox>
            
        </HBox>
    </center>

</BorderPane>
