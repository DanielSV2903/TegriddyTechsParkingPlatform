<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.tegriddytechs.parkingplatform.tegriddytechsparkingplatform.view.MainMenuController"
            style="-fx-background-color: #f0f4f8;">

    <!-- Top Section -->
    <top>
        <VBox style="-fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
            <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-padding: 16 28;">
                <!-- Logo and Title -->
                <HBox alignment="CENTER_LEFT" spacing="14">
                    <StackPane>
                        <Circle radius="22" fill="#667eea"/>
                        <SVGPath content="M 0,-8 L 0,8 M -5,0 L 5,0"
                                 fill="transparent" stroke="white" strokeWidth="2"/>
                    </StackPane>
                    <VBox spacing="2">
                        <Label text="TegriddyTechs Parking"
                               style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2d3748;"/>
                        <Label text="Panel de Administración"
                               style="-fx-font-size: 12px; -fx-text-fill: #718096;"/>
                    </VBox>
                </HBox>

                <Region HBox.hgrow="ALWAYS"/>

                <!-- User Info -->
                <HBox alignment="CENTER" spacing="12">
                    <VBox alignment="CENTER_RIGHT" spacing="2">
                        <Label text="Administrador"
                               style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #2d3748;"/>
                        <Label text="admin@tegriddytechs.com"
                               style="-fx-font-size: 11px; -fx-text-fill: #718096;"/>
                    </VBox>
                    <Circle radius="20" fill="#667eea"/>
                </HBox>

                <!-- Logout Button -->
                <Button text="Cerrar Sesión" onAction="#logOut"
                        style="-fx-background-color: #fee; -fx-text-fill: #e53e3e;
                               -fx-font-size: 13px; -fx-font-weight: 600;
                               -fx-background-radius: 8; -fx-padding: 10 20;
                               -fx-cursor: hand;"/>
            </HBox>
            <Separator/>
        </VBox>
    </top>

    <!-- Center Content -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background: transparent;">
            <VBox spacing="24" style="-fx-padding: 24 28;">

                <!-- Statistics Cards -->
                <VBox spacing="12">
                    <Label text="Estadísticas Generales"
                           style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2d3748;"/>

                    <GridPane hgap="20" vgap="20">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="25" />
                            <ColumnConstraints percentWidth="25" />
                            <ColumnConstraints percentWidth="25" />
                            <ColumnConstraints percentWidth="25" />
                        </columnConstraints>

                        <!-- Card 1 -->
                        <VBox spacing="12" GridPane.rowIndex="0" GridPane.columnIndex="0"
                              style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 24;">
                            <HBox alignment="CENTER_LEFT" spacing="14">
                                <StackPane>
                                    <Circle radius="28" fill="#e6f2ff"/>
                                    <SVGPath content="M -8,-8 L 8,-8 L 8,8 L -8,8 Z M -5,-5 L 5,-5 M -5,0 L 5,0 M -5,5 L 5,5"
                                             fill="transparent" stroke="#3182ce" strokeWidth="2"/>
                                </StackPane>
                                <VBox spacing="4">
                                    <Label text="Total Parqueaderos"
                                           style="-fx-font-size: 13px; -fx-text-fill: #718096;"/>
                                    <Label text="8"
                                           style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2d3748;"/>
                                </VBox>
                            </HBox>
                        </VBox>

                        <!-- Card 2 -->
                        <VBox spacing="12" GridPane.rowIndex="0" GridPane.columnIndex="1"
                              style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 24;">
                            <HBox alignment="CENTER_LEFT" spacing="14">
                                <StackPane>
                                    <Circle radius="28" fill="#e6ffed"/>
                                    <SVGPath content="M -6,-6 L 6,-6 L 6,6 L -6,6 Z M 0,-2 L 0,6"
                                             fill="transparent" stroke="#38a169" strokeWidth="2"/>
                                </StackPane>
                                <VBox spacing="4">
                                    <Label text="Espacios Disponibles"
                                           style="-fx-font-size: 13px; -fx-text-fill: #718096;"/>
                                    <Label text="145"
                                           style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2d3748;"/>
                                </VBox>
                            </HBox>
                        </VBox>

                        <!-- Card 3 -->
                        <VBox spacing="12" GridPane.rowIndex="0" GridPane.columnIndex="2"
                              style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 24;">
                            <HBox alignment="CENTER_LEFT" spacing="14">
                                <StackPane>
                                    <Circle radius="28" fill="#fff5e6"/>
                                    <SVGPath content="M -8,0 L -4,-4 L 0,0 L 4,-4 L 8,0 M -6,0 L -6,6 L 6,6 L 6,0"
                                             fill="transparent" stroke="#dd6b20" strokeWidth="2"/>
                                </StackPane>
                                <VBox spacing="4">
                                    <Label text="Vehículos Activos"
                                           style="-fx-font-size: 13px; -fx-text-fill: #718096;"/>
                                    <Label text="73"
                                           style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2d3748;"/>
                                </VBox>
                            </HBox>
                        </VBox>

                        <!-- Card 4 -->
                        <VBox spacing="12" GridPane.rowIndex="0" GridPane.columnIndex="3"
                              style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 24;">
                            <HBox alignment="CENTER_LEFT" spacing="14">
                                <StackPane>
                                    <Circle radius="28" fill="#f0e6ff"/>
                                    <SVGPath content="M -2,-8 L -2,0 M 2,-8 L 2,0 M -6,0 C -6,3 -2,6 2,6 C 6,6 6,3 6,0"
                                             fill="transparent" stroke="#805ad5" strokeWidth="2"/>
                                </StackPane>
                                <VBox spacing="4">
                                    <Label text="Ingresos Hoy"
                                           style="-fx-font-size: 13px; -fx-text-fill: #718096;"/>
                                    <Label text="$2,450"
                                           style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2d3748;"/>
                                </VBox>
                            </HBox>
                        </VBox>
                    </GridPane>
                </VBox>

                <!-- System Management Section -->
                <VBox spacing="14">
                    <Label text="Gestión del Sistema"
                           style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2d3748;"/>

                    <GridPane hgap="16" vgap="16">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="25" />
                            <ColumnConstraints percentWidth="25" />
                            <ColumnConstraints percentWidth="25" />
                            <ColumnConstraints percentWidth="25" />
                        </columnConstraints>

                        <!-- Usuarios -->
                        <VBox spacing="0" GridPane.rowIndex="0" GridPane.columnIndex="0"
                              style="-fx-background-color: white; -fx-background-radius: 12; -fx-cursor: hand;">
                            <VBox spacing="12" style="-fx-padding: 20;">
                                <HBox alignment="CENTER_LEFT" spacing="12">
                                    <StackPane>
                                        <Circle radius="20" fill="#ebf4ff"/>
                                        <SVGPath content="M 0,-6 C -3,-6 -6,-3 -6,0 C -6,3 -3,6 0,6 C 3,6 6,3 6,0 C 6,-3 3,-6 0,-6 Z"
                                                 fill="#3182ce"/>
                                    </StackPane>
                                    <Label text="Usuarios"
                                           style="-fx-font-size: 16px; -fx-font-weight: 600; -fx-text-fill: #2d3748;"/>
                                </HBox>
                                <Label text="Gestión completa de usuarios del sistema"
                                       wrapText="true"
                                       style="-fx-font-size: 12px; -fx-text-fill: #718096;"/>
                            </VBox>
                            <Region prefHeight="10"/>
                            <Button text="Administrar →" onAction="#openCrud"
                                    userData="Usuarios" maxWidth="Infinity"
                                    style="-fx-background-color: #f7fafc; -fx-text-fill: #3182ce;
                                           -fx-font-size: 13px; -fx-font-weight: 600;
                                           -fx-background-radius: 0 0 12 12; -fx-padding: 14;
                                           -fx-cursor: hand;"/>
                        </VBox>

                        <!-- Administradores -->
                        <VBox spacing="0" GridPane.rowIndex="0" GridPane.columnIndex="1"
                              style="-fx-background-color: white; -fx-background-radius: 12; -fx-cursor: hand;">
                            <VBox spacing="12" style="-fx-padding: 20;">
                                <HBox alignment="CENTER_LEFT" spacing="12">
                                    <StackPane>
                                        <Circle radius="20" fill="#fef5e7"/>
                                        <SVGPath content="M -4,-2 L 0,-6 L 4,-2 M 0,-6 L 0,2 M -6,6 L 6,6"
                                                 fill="transparent" stroke="#d69e2e" strokeWidth="1.8"/>
                                    </StackPane>
                                    <Label text="Administradores"
                                           style="-fx-font-size: 16px; -fx-font-weight: 600; -fx-text-fill: #2d3748;"/>
                                </HBox>
                                <Label text="Control de administradores del sistema"
                                       wrapText="true"
                                       style="-fx-font-size: 12px; -fx-text-fill: #718096;"/>
                            </VBox>
                            <Region prefHeight="10"/>
                            <Button text="Administrar →" onAction="#openCrud"
                                    userData="Administradores" maxWidth="Infinity"
                                    style="-fx-background-color: #f7fafc; -fx-text-fill: #d69e2e;
                                           -fx-font-size: 13px; -fx-font-weight: 600;
                                           -fx-background-radius: 0 0 12 12; -fx-padding: 14;
                                           -fx-cursor: hand;"/>
                        </VBox>

                        <!-- Cajeros -->
                        <VBox spacing="0" GridPane.rowIndex="0" GridPane.columnIndex="2"
                              style="-fx-background-color: white; -fx-background-radius: 12; -fx-cursor: hand;">
                            <VBox spacing="12" style="-fx-padding: 20;">
                                <HBox alignment="CENTER_LEFT" spacing="12">
                                    <StackPane>
                                        <Circle radius="20" fill="#e6f9f0"/>
                                        <SVGPath content="M -6,0 L -2,0 M 2,0 L 6,0 M -3,-4 L -3,4 M 3,-4 L 3,4"
                                                 fill="transparent" stroke="#38a169" strokeWidth="1.8"/>
                                    </StackPane>
                                    <Label text="Cajeros"
                                           style="-fx-font-size: 16px; -fx-font-weight: 600; -fx-text-fill: #2d3748;"/>
                                </HBox>
                                <Label text="Gestión de personal de atención"
                                       wrapText="true"
                                       style="-fx-font-size: 12px; -fx-text-fill: #718096;"/>
                            </VBox>
                            <Region prefHeight="10"/>
                            <Button text="Administrar →" onAction="#openCrud"
                                    userData="Cajeros" maxWidth="Infinity"
                                    style="-fx-background-color: #f7fafc; -fx-text-fill: #38a169;
                                           -fx-font-size: 13px; -fx-font-weight: 600;
                                           -fx-background-radius: 0 0 12 12; -fx-padding: 14;
                                           -fx-cursor: hand;"/>
                        </VBox>

                        <!-- Tarifas -->
                        <VBox spacing="0" GridPane.rowIndex="0" GridPane.columnIndex="3"
                              style="-fx-background-color: white; -fx-background-radius: 12; -fx-cursor: hand;">
                            <VBox spacing="12" style="-fx-padding: 20;">
                                <HBox alignment="CENTER_LEFT" spacing="12">
                                    <StackPane>
                                        <Circle radius="20" fill="#fef0f5"/>
                                        <SVGPath content="M -2,-6 L -2,2 M 2,-6 L 2,2 M -6,2 L 6,2 L 6,6 L -6,6 Z"
                                                 fill="transparent" stroke="#d53f8c" strokeWidth="1.8"/>
                                    </StackPane>
                                    <Label text="Tarifas"
                                           style="-fx-font-size: 16px; -fx-font-weight: 600; -fx-text-fill: #2d3748;"/>
                                </HBox>
                                <Label text="Configuración de precios y tarifas"
                                       wrapText="true"
                                       style="-fx-font-size: 12px; -fx-text-fill: #718096;"/>
                            </VBox>
                            <Region prefHeight="10"/>
                            <Button text="Administrar →" onAction="#openCrud"
                                    userData="Tarifas" maxWidth="Infinity"
                                    style="-fx-background-color: #f7fafc; -fx-text-fill: #d53f8c;
                                           -fx-font-size: 13px; -fx-font-weight: 600;
                                           -fx-background-radius: 0 0 12 12; -fx-padding: 14;
                                           -fx-cursor: hand;"/>
                        </VBox>
                    </GridPane>
                </VBox>

                <!-- Operational Management Section -->
                <VBox spacing="14">
                    <Label text="Gestión Operativa"
                           style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2d3748;"/>

                    <GridPane hgap="16" vgap="16">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="25" />
                            <ColumnConstraints percentWidth="25" />
                            <ColumnConstraints percentWidth="25" />
                            <ColumnConstraints percentWidth="25" />
                        </columnConstraints>

                        <!-- Clientes -->
                        <VBox spacing="0" GridPane.rowIndex="0" GridPane.columnIndex="0"
                              style="-fx-background-color: white; -fx-background-radius: 12; -fx-cursor: hand;">
                            <VBox spacing="12" style="-fx-padding: 20;">
                                <HBox alignment="CENTER_LEFT" spacing="12">
                                    <StackPane>
                                        <Circle radius="20" fill="#f0e6ff"/>
                                        <SVGPath content="M -4,-4 C -6,-4 -7,-2 -7,0 C -7,2 -6,4 -4,4 C -2,4 -1,2 -1,0 C -1,-2 -2,-4 -4,-4 Z M 4,-4 C 2,-4 1,-2 1,0 C 1,2 2,4 4,4 C 6,4 7,2 7,0 C 7,-2 6,-4 4,-4 Z"
                                                 fill="#805ad5"/>
                                    </StackPane>
                                    <Label text="Clientes"
                                           style="-fx-font-size: 16px; -fx-font-weight: 600; -fx-text-fill: #2d3748;"/>
                                </HBox>
                                <Label text="Registro y administración de clientes"
                                       wrapText="true"
                                       style="-fx-font-size: 12px; -fx-text-fill: #718096;"/>
                            </VBox>
                            <Region prefHeight="10"/>
                            <Button text="Administrar →" onAction="#openCrud"
                                    userData="Clientes" maxWidth="Infinity"
                                    style="-fx-background-color: #f7fafc; -fx-text-fill: #805ad5;
                                           -fx-font-size: 13px; -fx-font-weight: 600;
                                           -fx-background-radius: 0 0 12 12; -fx-padding: 14;
                                           -fx-cursor: hand;"/>
                        </VBox>

                        <!-- Parqueaderos -->
                        <VBox spacing="0" GridPane.rowIndex="0" GridPane.columnIndex="1"
                              style="-fx-background-color: white; -fx-background-radius: 12; -fx-cursor: hand;">
                            <VBox spacing="12" style="-fx-padding: 20;">
                                <HBox alignment="CENTER_LEFT" spacing="12">
                                    <StackPane>
                                        <Circle radius="20" fill="#e6f2ff"/>
                                        <SVGPath content="M -6,-6 L 6,-6 L 6,6 L -6,6 Z M -3,-3 L 3,-3 M -3,0 L 3,0 M -3,3 L 3,3"
                                                 fill="transparent" stroke="#3182ce" strokeWidth="1.8"/>
                                    </StackPane>
                                    <Label text="Parqueaderos"
                                           style="-fx-font-size: 16px; -fx-font-weight: 600; -fx-text-fill: #2d3748;"/>
                                </HBox>
                                <Label text="Control de parqueaderos y ubicaciones"
                                       wrapText="true"
                                       style="-fx-font-size: 12px; -fx-text-fill: #718096;"/>
                            </VBox>
                            <Region prefHeight="10"/>
                            <Button text="Administrar →" onAction="#openCrud"
                                    userData="Parqueaderos" maxWidth="Infinity"
                                    style="-fx-background-color: #f7fafc; -fx-text-fill: #3182ce;
                                           -fx-font-size: 13px; -fx-font-weight: 600;
                                           -fx-background-radius: 0 0 12 12; -fx-padding: 14;
                                           -fx-cursor: hand;"/>
                        </VBox>

                        <!-- Espacios -->
                        <VBox spacing="0" GridPane.rowIndex="0" GridPane.columnIndex="2"
                              style="-fx-background-color: white; -fx-background-radius: 12; -fx-cursor: hand;">
                            <VBox spacing="12" style="-fx-padding: 20;">
                                <HBox alignment="CENTER_LEFT" spacing="12">
                                    <StackPane>
                                        <Circle radius="20" fill="#e6ffed"/>
                                        <SVGPath content="M -6,0 L 0,-6 L 6,0 L 0,6 Z"
                                                 fill="transparent" stroke="#38a169" strokeWidth="1.8"/>
                                    </StackPane>
                                    <Label text="Espacios"
                                           style="-fx-font-size: 16px; -fx-font-weight: 600; -fx-text-fill: #2d3748;"/>
                                </HBox>
                                <Label text="Gestión de espacios de estacionamiento"
                                       wrapText="true"
                                       style="-fx-font-size: 12px; -fx-text-fill: #718096;"/>
                            </VBox>
                            <Region prefHeight="10"/>
                            <Button text="Administrar →" onAction="#openCrud"
                                    userData="Espacios" maxWidth="Infinity"
                                    style="-fx-background-color: #f7fafc; -fx-text-fill: #38a169;
                                           -fx-font-size: 13px; -fx-font-weight: 600;
                                           -fx-background-radius: 0 0 12 12; -fx-padding: 14;
                                           -fx-cursor: hand;"/>
                        </VBox>

                        <!-- Vehículos -->
                        <VBox spacing="0" GridPane.rowIndex="0" GridPane.columnIndex="3"
                              style="-fx-background-color: white; -fx-background-radius: 12; -fx-cursor: hand;">
                            <VBox spacing="12" style="-fx-padding: 20;">
                                <HBox alignment="CENTER_LEFT" spacing="12">
                                    <StackPane>
                                        <Circle radius="20" fill="#fff5e6"/>
                                        <SVGPath content="M -7,2 L -4,-2 L 4,-2 L 7,2 M -5,2 L -5,5 M 5,2 L 5,5 M -7,5 L 7,5"
                                                 fill="transparent" stroke="#dd6b20" strokeWidth="1.8"/>
                                    </StackPane>
                                    <Label text="Vehículos"
                                           style="-fx-font-size: 16px; -fx-font-weight: 600; -fx-text-fill: #2d3748;"/>
                                </HBox>
                                <Label text="Registro y control de vehículos"
                                       wrapText="true"
                                       style="-fx-font-size: 12px; -fx-text-fill: #718096;"/>
                            </VBox>
                            <Region prefHeight="10"/>
                            <Button text="Administrar →" onAction="#openCrud"
                                    userData="Vehiculos" maxWidth="Infinity"
                                    style="-fx-background-color: #f7fafc; -fx-text-fill: #dd6b20;
                                           -fx-font-size: 13px; -fx-font-weight: 600;
                                           -fx-background-radius: 0 0 12 12; -fx-padding: 14;
                                           -fx-cursor: hand;"/>
                        </VBox>

                        <!-- Tickets -->
                        <VBox spacing="0" GridPane.rowIndex="1" GridPane.columnIndex="0"
                              style="-fx-background-color: white; -fx-background-radius: 12; -fx-cursor: hand;">
                            <VBox spacing="12" style="-fx-padding: 20;">
                                <HBox alignment="CENTER_LEFT" spacing="12">
                                    <StackPane>
                                        <Circle radius="20" fill="#fef5e7"/>
                                        <SVGPath content="M -4,-6 L 4,-6 L 4,6 L -4,6 Z M -2,-3 L 2,-3 M -2,0 L 2,0 M -2,3 L 2,3"
                                                 fill="transparent" stroke="#d69e2e" strokeWidth="1.8"/>
                                    </StackPane>
                                    <Label text="Tickets"
                                           style="-fx-font-size: 16px; -fx-font-weight: 600; -fx-text-fill: #2d3748;"/>
                                </HBox>
                                <Label text="Gestión de tickets de estacionamiento"
                                       wrapText="true"
                                       style="-fx-font-size: 12px; -fx-text-fill: #718096;"/>
                            </VBox>
                            <Region prefHeight="10"/>
                            <Button text="Administrar →" onAction="#openCrud"
                                    userData="Tickets" maxWidth="Infinity"
                                    style="-fx-background-color: #f7fafc; -fx-text-fill: #d69e2e;
                                           -fx-font-size: 13px; -fx-font-weight: 600;
                                           -fx-background-radius: 0 0 12 12; -fx-padding: 14;
                                           -fx-cursor: hand;"/>
                        </VBox>
                    </GridPane>
                </VBox>

            </VBox>
        </ScrollPane>
