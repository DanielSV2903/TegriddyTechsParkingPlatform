<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.tegriddytechs.parkingplatform.tegriddytechsparkingplatform.view.AdminCrudController"
            style="-fx-background-color: #f0f4f8;">

    <top>
        <VBox style="-fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
            <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-padding: 20 28;">
                <HBox alignment="CENTER_LEFT" spacing="14">
                    <StackPane>
                        <Circle radius="24" fill="#d69e2e"/>
                        <SVGPath content="M -4,-2 L 0,-6 L 4,-2 M 0,-6 L 0,2 M -6,6 L 6,6"
                                 style="-fx-fill: transparent; -fx-stroke: white; -fx-stroke-width: 1.8;"/>
                    </StackPane>
                    <VBox spacing="2">
                        <Label text="Gestión de Administradores"
                               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2d3748;"/>
                        <Label text="Crea, actualiza o elimina administradores del sistema"
                               style="-fx-font-size: 12px; -fx-text-fill: #718096;"/>
                    </VBox>
                </HBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Regresar al Menú" onAction="#goBack"
                        style="-fx-background-color: #f7fafc; -fx-text-fill: #d69e2e; -fx-font-size: 13px; -fx-font-weight: 600; -fx-background-radius: 8; -fx-padding: 10 20; -fx-cursor: hand; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-border-width: 1;"/>
            </HBox>
            <Separator style="-fx-background-color: #e2e8f0;"/>
        </VBox>
    </top>

    <center>
        <HBox spacing="24" style="-fx-padding: 24 28;">
            <!-- Formulario izquierdo -->
            <VBox spacing="20" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 24; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);" prefWidth="380">
                <Label text="Datos del Administrador"
                       style="-fx-font-size: 16px; -fx-font-weight: 600; -fx-text-fill: #2d3748;"/>

                <VBox spacing="16">
                    <VBox spacing="6">
                        <Label text="ID (automático)"
                               style="-fx-font-size: 13px; -fx-font-weight: 500; -fx-text-fill: #4a5568;"/>
                        <TextField fx:id="tfId"
                                   style="-fx-background-color: #f7fafc; -fx-background-radius: 8; -fx-border-color: #cbd5e0; -fx-border-radius: 8; -fx-border-width: 1.5; -fx-padding: 12 14; -fx-font-size: 13px; -fx-text-fill: #2d3748;"
                                   prefHeight="42" editable="false"/>
                    </VBox>

                    <VBox spacing="6">
                        <Label text="Nombre Completo"
                               style="-fx-font-size: 13px; -fx-font-weight: 500; -fx-text-fill: #4a5568;"/>
                        <TextField fx:id="tfName"
                                   style="-fx-background-color: #f7fafc; -fx-background-radius: 8; -fx-border-color: #cbd5e0; -fx-border-radius: 8; -fx-border-width: 1.5; -fx-padding: 12 14; -fx-font-size: 13px; -fx-text-fill: #2d3748;"
                                   prefHeight="42"/>
                    </VBox>

                    <VBox spacing="6">
                        <Label text="Usuario"
                               style="-fx-font-size: 13px; -fx-font-weight: 500; -fx-text-fill: #4a5568;"/>
                        <TextField fx:id="tfUsername"
                                   style="-fx-background-color: #f7fafc; -fx-background-radius: 8; -fx-border-color: #cbd5e0; -fx-border-radius: 8; -fx-border-width: 1.5; -fx-padding: 12 14; -fx-font-size: 13px; -fx-text-fill: #2d3748;"
                                   prefHeight="42"/>
                    </VBox>

                    <VBox spacing="6">
                        <Label text="Contraseña"
                               style="-fx-font-size: 13px; -fx-font-weight: 500; -fx-text-fill: #4a5568;"/>
                        <PasswordField fx:id="tfPassword"
                                       style="-fx-background-color: #f7fafc; -fx-background-radius: 8; -fx-border-color: #cbd5e0; -fx-border-radius: 8; -fx-border-width: 1.5; -fx-padding: 12 14; -fx-font-size: 13px; -fx-text-fill: #2d3748;"
                                       prefHeight="42"/>
                    </VBox>
                </VBox>

                <VBox spacing="12" style="-fx-padding: 20 0 0 0;">
                    <Button text="Crear Administrador" onAction="#onCreate"
                            style="-fx-background-color: #48bb78; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: 600; -fx-background-radius: 8; -fx-padding: 14; -fx-cursor: hand;"
                            maxWidth="Infinity"/>
                    <Button text="Actualizar Administrador" onAction="#onUpdate"
                            style="-fx-background-color: #4299e1; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: 600; -fx-background-radius: 8; -fx-padding: 14; -fx-cursor: hand;"
                            maxWidth="Infinity"/>
                    <Button text="Eliminar Administrador" onAction="#onDelete"
                            style="-fx-background-color: #f56565; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: 600; -fx-background-radius: 8; -fx-padding: 14; -fx-cursor: hand;"
                            maxWidth="Infinity"/>
                    <Button text="Limpiar Formulario" onAction="#onClear"
                            style="-fx-background-color: #f7fafc; -fx-text-fill: #4a5568; -fx-font-size: 13px; -fx-font-weight: 600; -fx-background-radius: 8; -fx-padding: 14; -fx-cursor: hand; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-border-width: 1;"
                            maxWidth="Infinity"/>
                </VBox>
            </VBox>

            <!-- Tabla derecha -->
            <VBox spacing="16" style="-fx-pref-width: 700;">
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label text="Lista de Administradores"
                           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2d3748;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <TextField fx:id="tfSearch" promptText="Buscar por nombre o usuario..."
                               style="-fx-background-color: #f7fafc; -fx-background-radius: 8; -fx-border-color: #cbd5e0; -fx-border-radius: 8; -fx-border-width: 1.5; -fx-padding: 10 14; -fx-font-size: 13px; -fx-text-fill: #2d3748;"
                               prefHeight="38" prefWidth="240"/>
                    <Button text="Actualizar Tabla" onAction="#onRefresh"
                            style="-fx-background-color: #f7fafc; -fx-text-fill: #d69e2e; -fx-font-size: 13px; -fx-font-weight: 600; -fx-background-radius: 8; -fx-padding: 10 20; -fx-cursor: hand; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-border-width: 1;"/>
                </HBox>

                <TableView fx:id="tableAdmins"
                           style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">
                    <columns>
                        <TableColumn fx:id="colId" text="ID" prefWidth="80"/>
                        <TableColumn fx:id="colName" text="Nombre" prefWidth="200"/>
                        <TableColumn fx:id="colUsername" text="Usuario" prefWidth="150"/>
                    </columns>
                </TableView>

                <HBox alignment="CENTER_LEFT">
                    <Label fx:id="lblTotalRecords" text="Total: 0 registros"
                           style="-fx-font-size: 13px; -fx-text-fill: #718096;"/>
                </HBox>
            </VBox>
        </HBox>
    </center>
</BorderPane>