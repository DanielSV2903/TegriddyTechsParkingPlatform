<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane prefHeight="800" prefWidth="1200" style="-fx-background-color: #f0f4f8;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.tegriddytechs.parkingplatform.tegriddytechsparkingplatform.view.MainMenuController">

    <!-- TOP BAR -->
    <top>
        <VBox style="-fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
            <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-padding: 16 28;">

                <!-- Logo y nombre -->
                <HBox alignment="CENTER_LEFT" spacing="14">
                    <Circle fill="#38a169" radius="22" />
                    <VBox spacing="2">
                        <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2d3748;" text="TegriddyTechs Parking" />
                        <Label style="-fx-font-size: 12px; -fx-text-fill: #718096;" text="Panel de Cajero" />
                    </VBox>
                </HBox>

                <!-- Espaciador -->
                <Region prefWidth="300" />

                <!-- Información usuario -->
                <HBox alignment="CENTER" spacing="12">
                    <VBox alignment="CENTER_RIGHT" spacing="2">
                        <Label style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #2d3748;" text="Cajero" />
                        <Label style="-fx-font-size: 11px; -fx-text-fill: #718096;" text="cajero@tegriddytechs.com" />
                    </VBox>
                    <Circle fill="#38a169" radius="20" />
                </HBox>

                <!-- Botón cerrar sesión -->
                <Button onAction="#logOut" style="-fx-background-color: #fee; -fx-text-fill: #e53e3e; -fx-font-size: 13px;                                -fx-font-weight: 600; -fx-background-radius: 8; -fx-padding: 10 20;                                -fx-border-color: #feb2b2; -fx-border-radius: 8; -fx-border-width: 1;" text="Cerrar Sesion" />
            </HBox>
            <Separator style="-fx-background-color: #e2e8f0;" />
        </VBox>
    </top>

    <!-- CONTENIDO PRINCIPAL -->
    <center>
        <ScrollPane fitToWidth="true" prefHeight="635.0" prefWidth="1200.0" style="-fx-background: transparent; -fx-background-color: transparent;">
            <VBox spacing="24" style="-fx-padding: 24 28;">

                <!-- MENSAJE DE BIENVENIDA -->
                <VBox spacing="8" style="-fx-padding: 0 0 12 0;">
                    <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2d3748;" text="Bienvenido al Sistema" />
                    <Label style="-fx-font-size: 14px; -fx-text-fill: #718096;" text="Accede a las funciones disponibles para tu rol" />
                </VBox>

                <!-- SECCIÓN GESTIÓN OPERATIVA -->
                <VBox spacing="14">
                    <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2d3748;" text="Gestión Operativa" />

                    <GridPane hgap="20" vgap="20">

                        <!-- Tarjeta Clientes -->
                        <VBox style="-fx-background-color: white; -fx-background-radius: 12;                                      -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);                                      -fx-pref-width: 280; -fx-pref-height: 160;" GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <VBox spacing="14" style="-fx-padding: 24;">
                                <HBox alignment="CENTER_LEFT" spacing="14">
                                    <Circle fill="#f0e6ff" radius="24" />
                                    <Label style="-fx-font-size: 18px; -fx-font-weight: 600; -fx-text-fill: #2d3748;" text="Clientes" />
                                </HBox>
                                <Label style="-fx-font-size: 13px; -fx-text-fill: #718096; -fx-wrap-text: true;" text="Registro y administracion de clientes del sistema" />
                            </VBox>
                            <Region prefHeight="12" />
                            <Button maxWidth="Infinity" onAction="#openCrud" userData="Clientes" 
                                    style="-fx-background-color: linear-gradient(to right, #805ad5, #9f7aea); 
                                           -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: 600; 
                                           -fx-background-radius: 0 0 12 12; -fx-padding: 16;
                                           -fx-cursor: hand;" text="Administrar" />
                        </VBox>

                        <!-- Tarjeta Parqueaderos -->
                        <VBox style="-fx-background-color: white; -fx-background-radius: 12;                                      -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);                                      -fx-pref-width: 280; -fx-pref-height: 160;" GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <VBox spacing="14" style="-fx-padding: 24;">
                                <HBox alignment="CENTER_LEFT" spacing="14">
                                    <Circle fill="#e6f2ff" radius="24" />
                                    <Label style="-fx-font-size: 18px; -fx-font-weight: 600; -fx-text-fill: #2d3748;" text="Parqueaderos" />
                                </HBox>
                                <Label style="-fx-font-size: 13px; -fx-text-fill: #718096; -fx-wrap-text: true;" text="Control de parqueaderos y ubicaciones disponibles" />
                            </VBox>
                            <Region prefHeight="12" />
                            <Button maxWidth="Infinity" onAction="#openCrud" userData="Parqueaderos" 
                                    style="-fx-background-color: linear-gradient(to right, #3182ce, #4299e1); 
                                           -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: 600; 
                                           -fx-background-radius: 0 0 12 12; -fx-padding: 16;
                                           -fx-cursor: hand;" text="Administrar" />
                        </VBox>

                        <!-- Tarjeta Vehículos -->
                        <VBox style="-fx-background-color: white; -fx-background-radius: 12;                                      -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);                                      -fx-pref-width: 280; -fx-pref-height: 160;" GridPane.columnIndex="2" GridPane.rowIndex="0">
                            <VBox spacing="14" style="-fx-padding: 24;">
                                <HBox alignment="CENTER_LEFT" spacing="14">
                                    <Circle fill="#fff5e6" radius="24" />
                                    <Label style="-fx-font-size: 18px; -fx-font-weight: 600; -fx-text-fill: #2d3748;" text="Vehiculos" />
                                </HBox>
                                <Label style="-fx-font-size: 13px; -fx-text-fill: #718096; -fx-wrap-text: true;" text="Registro y control de vehiculos en el sistema" />
                            </VBox>
                            <Region prefHeight="12" />
                            <Button maxWidth="Infinity" onAction="#openCrud" userData="Vehiculos" 
                                    style="-fx-background-color: linear-gradient(to right, #dd6b20, #ed8936); 
                                           -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: 600; 
                                           -fx-background-radius: 0 0 12 12; -fx-padding: 16;
                                           -fx-cursor: hand;" text="Administrar" />
                        </VBox>

                        <!-- Tarjeta Tickets -->
                        <VBox style="-fx-background-color: white; -fx-background-radius: 12;                                      -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);                                      -fx-pref-width: 280; -fx-pref-height: 160;" GridPane.columnIndex="3" GridPane.rowIndex="0">
                            <VBox spacing="14" style="-fx-padding: 24;">
                                <HBox alignment="CENTER_LEFT" spacing="14">
                                    <Circle fill="#fef5e7" radius="24" />
                                    <Label style="-fx-font-size: 18px; -fx-font-weight: 600; -fx-text-fill: #2d3748;" text="Tickets" />
                                </HBox>
                                <Label style="-fx-font-size: 13px; -fx-text-fill: #718096; -fx-wrap-text: true;" text="Gestion de tickets de estacionamiento activos" />
                            </VBox>
                            <Region prefHeight="12" />
                            <Button maxWidth="Infinity" onAction="#openCrud" userData="Tickets" 
                                    style="-fx-background-color: linear-gradient(to right, #d69e2e, #ecc94b); 
                                           -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: 600; 
                                           -fx-background-radius: 0 0 12 12; -fx-padding: 16;
                                           -fx-cursor: hand;" text="Administrar" />
                        </VBox>

                        <columnConstraints>
                            <ColumnConstraints />
                            <ColumnConstraints />
                            <ColumnConstraints />
                            <ColumnConstraints />
                        </columnConstraints>
                        <rowConstraints>
                            <RowConstraints />
                        </rowConstraints>

                    </GridPane>
                </VBox>

                <!-- SECCIÓN DE AYUDA -->
                <VBox spacing="12" style="-fx-background-color: #ebf4ff; -fx-background-radius: 12; -fx-padding: 20;">
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <Circle fill="#3182ce" radius="18" />
                        <Label style="-fx-font-size: 16px; -fx-font-weight: 600; -fx-text-fill: #2d3748;" text="Informacion del Sistema" />
                    </HBox>
                    <Label style="-fx-font-size: 13px; -fx-text-fill: #4a5568; -fx-wrap-text: true;" 
                           text="Como cajero, tienes acceso a las funciones operativas principales del sistema. Puedes registrar clientes, gestionar vehiculos, administrar espacios de parqueadero y procesar tickets de estacionamiento." />
                </VBox>

                <!-- ESPACIADOR FINAL -->
                <VBox style="-fx-padding: 20 0;" />

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
