<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<BorderPane prefHeight="800" prefWidth="1200"
            style="-fx-background-color: #f0f4f8;"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.tegriddytechs.parkingplatform.tegriddytechsparkingplatform.view.ParkingOperationViewController">

    <!-- ================= TOP BAR ================= -->
    <top>
        <VBox style="-fx-background-color: white;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
            <HBox alignment="CENTER_LEFT" spacing="16" style="-fx-padding: 16 28;">
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Circle fill="#3182ce" radius="20"/>
                    <VBox spacing="2">
                        <Label text="Operación de Parqueo"
                               style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2d3748;"/>
                        <Label text="Parquear / Desparquear vehículos"
                               style="-fx-font-size: 12px; -fx-text-fill: #718096;"/>
                    </VBox>
                </HBox>

                <Region HBox.hgrow="ALWAYS"/>

                <HBox alignment="CENTER" spacing="10">
                    <Label text="Parqueo:"
                           style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #4a5568;"/>
                    <ComboBox fx:id="cbParkingLot"
                              prefHeight="36"
                              prefWidth="260"
                              promptText="Seleccione un parqueo..."
                              style="-fx-background-color: #f7fafc;
                                     -fx-background-radius: 8;
                                     -fx-border-color: #cbd5e0;
                                     -fx-border-radius: 8;
                                     -fx-border-width: 1.5;"/>
                    <Button text="↻"
                            prefHeight="36"
                            onAction="#onRefreshLots"
                            style="-fx-background-color: white;
                                   -fx-border-color: #cbd5e0;
                                   -fx-border-radius: 8;
                                   -fx-border-width: 1.5;
                                   -fx-font-weight: 700;"/>
                </HBox>

                <Button text="← Volver"
                        onAction="#goBack"
                        style="-fx-background-color: #edf2f7;
                               -fx-text-fill: #4a5568;
                               -fx-font-weight: 600;
                               -fx-background-radius: 8;
                               -fx-padding: 10 18;"/>
            </HBox>
            <Separator style="-fx-background-color: #e2e8f0;"/>
        </VBox>
    </top>

    <!-- ================= CENTER ================= -->
    <center>
        <HBox spacing="24" style="-fx-padding: 24 28;">

            <!-- ========== LEFT PANEL ========= -->
            <VBox prefWidth="380" spacing="18"
                  style="-fx-background-color: white;
                         -fx-background-radius: 12;
                         -fx-padding: 22;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">

                <Label text="Acciones"
                       style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

                <VBox spacing="10"
                      style="-fx-padding: 10;
                             -fx-background-color: #f7fafc;
                             -fx-background-radius: 10;">

                    <Label text="Parquear vehículo" style="-fx-font-weight: 700;"/>
                    <Label text="Placa" style="-fx-font-size: 12px;"/>

                    <TextField fx:id="tfPlatePark"
                               prefHeight="40"
                               promptText="Ej: ABC123"/>

                    <Button text="✓ Parquear"
                            maxWidth="Infinity"
                            onAction="#onPark"
                            style="-fx-background-color: #48bb78;
                                   -fx-text-fill: white;
                                   -fx-font-weight: 700;
                                   -fx-background-radius: 8;
                                   -fx-padding: 12;"/>
                </VBox>

                <VBox spacing="10"
                      style="-fx-padding: 10;
                             -fx-background-color: #fff5f5;
                             -fx-background-radius: 10;">

                    <Label text="Desparquear (Salida)" style="-fx-font-weight: 700;"/>
                    <Label text="Placa" style="-fx-font-size: 12px;"/>

                    <TextField fx:id="tfPlateExit"
                               prefHeight="40"
                               promptText="Ej: ABC123"/>

                    <Button text="↪ Registrar salida"
                            maxWidth="Infinity"
                            onAction="#onExit"
                            style="-fx-background-color: #f56565;
                                   -fx-text-fill: white;
                                   -fx-font-weight: 700;
                                   -fx-background-radius: 8;
                                   -fx-padding: 12;"/>
                </VBox>

                <VBox spacing="6">
                    <Label text="Resultado" style="-fx-font-weight: 700;"/>
                    <Label fx:id="lblResult"
                           wrapText="true"
                           text="Seleccione un parqueo y realice una operación."
                           style="-fx-font-size: 12px; -fx-text-fill: #718096;"/>
                </VBox>

                <Region VBox.vgrow="ALWAYS"/>

                <HBox spacing="10">
                    <Button text="↻ Refrescar espacios"
                            HBox.hgrow="ALWAYS"
                            onAction="#onRefreshSpaces"/>
                    <Button text="Limpiar"
                            prefWidth="110"
                            onAction="#onClear"/>
                </HBox>
            </VBox>

            <!-- ========== RIGHT PANEL ========= -->
            <VBox spacing="14" prefWidth="760">

                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label text="Espacios de parqueo"
                           style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblLotSummary"
                           style="-fx-font-size: 12px; -fx-text-fill: #718096;"/>
                </HBox>

                <ScrollPane fitToWidth="true"
                            style="-fx-background: transparent; -fx-background-color: transparent;">
                    <content>
                        <TilePane fx:id="tileSpaces"
                                  prefColumns="10"
                                  hgap="10"
                                  vgap="10"
                                  style="-fx-background-color: white;
                                         -fx-background-radius: 12;
                                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">
                            <padding>
                                <Insets top="12" right="12" bottom="12" left="12"/>
                            </padding>
                        </TilePane>
                    </content>
                </ScrollPane>

                <VBox spacing="6"
                      style="-fx-background-color: white;
                             -fx-background-radius: 12;
                             -fx-padding: 14;">
                    <Label text="Detalle" style="-fx-font-weight: 700;"/>
                    <Label fx:id="lblSpaceDetail"
                           wrapText="true"
                           text="Seleccione un parqueo y luego un espacio."
                           style="-fx-font-size: 12px; -fx-text-fill: #718096;"/>
                </VBox>

            </VBox>

        </HBox>
    </center>

</BorderPane>