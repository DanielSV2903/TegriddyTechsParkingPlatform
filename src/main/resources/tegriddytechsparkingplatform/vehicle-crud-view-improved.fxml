<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane style="-fx-background-color: #f0f4f8;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.tegriddytechs.parkingplatform.tegriddytechsparkingplatform.view.VehicleCrudController">

    <top>
        <VBox style="-fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
            <HBox alignment="CENTER_LEFT" spacing="16" style="-fx-padding: 18 24;">
            <Circle fill="#e49b26" radius="24" />
                <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2d3748;" text="Gestión de Vehículos" />
                <Region HBox.hgrow="ALWAYS" />
                <Button onAction="#goBack" prefHeight="39.0" prefWidth="105.0" style="-fx-background-color: #edf2f7; -fx-text-fill: #4a5568;                                 -fx-font-size: 13px; -fx-font-weight: 600; -fx-background-radius: 8;                                 -fx-padding: 10 20; -fx-cursor: hand;" text="← Volver" />
            </HBox>
            <Separator style="-fx-background-color: #e2e8f0;" />
        </VBox>
    </top>

    <center>
        <HBox spacing="0">
            <VBox spacing="0" style="-fx-pref-width: 420; -fx-background-color: white;                                       -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 2, 0);">
                <VBox spacing="20" style="-fx-padding: 24;">
                    <VBox spacing="8">
                        <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2d3748;" text="Formulario de Vehículo" />
                        <Label style="-fx-font-size: 12px; -fx-text-fill: #718096;" text="Registre la información del vehículo" />
                    </VBox>
                    
                    <Separator style="-fx-background-color: #e2e8f0;" />
                    
                    <ScrollPane fitToWidth="true" style="-fx-background: transparent;">
                        <VBox spacing="20" style="-fx-padding: 4 2; -fx-background-color: white; -fx-padding: 24; -fx-effect: dropshadow(gaussian, rgba(72, 187, 120, 0.3), 8, 0, 0, 3);">
                            <VBox spacing="8">
                                <Label style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #4a5568;" text="Placa del Vehículo" />
                                <TextField fx:id="tfPlate" prefHeight="42" promptText="Ej: ABC-123" style="-fx-background-color: #f7fafc; -fx-background-radius: 8;                                                   -fx-border-color: #cbd5e0; -fx-border-radius: 8; -fx-border-width: 1.5;                                                  -fx-padding: 12 14; -fx-font-size: 13px;" />
                            </VBox>
                            
                            <VBox spacing="8">
                                <Label style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #4a5568;" text="Marca" />
                                <TextField fx:id="tfBrand" prefHeight="42" promptText="Ej: Toyota" style="-fx-background-color: #f7fafc; -fx-background-radius: 8;                                                   -fx-border-color: #cbd5e0; -fx-border-radius: 8; -fx-border-width: 1.5;                                                  -fx-padding: 12 14; -fx-font-size: 13px;" />
                            </VBox>
                            
                            <VBox spacing="8">
                                <Label style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #4a5568;" text="Modelo" />
                                <TextField fx:id="tfModel" prefHeight="42" promptText="Ej: Corolla" style="-fx-background-color: #f7fafc; -fx-background-radius: 8;                                                   -fx-border-color: #cbd5e0; -fx-border-radius: 8; -fx-border-width: 1.5;                                                  -fx-padding: 12 14; -fx-font-size: 13px;" />
                            </VBox>
                            
                            <VBox spacing="8">
                                <Label style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #4a5568;" text="Color" />
                                <TextField fx:id="tfColor" prefHeight="42" promptText="Ej: Blanco" style="-fx-background-color: #f7fafc; -fx-background-radius: 8;                                                   -fx-border-color: #cbd5e0; -fx-border-radius: 8; -fx-border-width: 1.5;                                                  -fx-padding: 12 14; -fx-font-size: 13px;" />
                            </VBox>
                            
                            <VBox spacing="8">
                                <Label style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #4a5568;" text="Tipo de Vehículo" />
                                <ComboBox fx:id="cbVehicleType" maxWidth="Infinity" prefHeight="42" promptText="Seleccione el tipo" style="-fx-background-color: #f7fafc; -fx-background-radius: 8;                                                  -fx-border-color: #cbd5e0; -fx-border-radius: 8; -fx-border-width: 1.5;                                                 -fx-padding: 8 14; -fx-font-size: 13px;" />
                            </VBox>
                            
                            <VBox spacing="8">
                                <Label style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #4a5568;" text="Dueños del Vehículo" />
                                <Button fx:id="btnConfigureOwners" onAction="#onConfigureOwners" maxWidth="Infinity" prefHeight="42"
                                        style="-fx-background-color: #edf2f7; -fx-text-fill: #2d3748; -fx-font-size: 13px; -fx-font-weight: 600; -fx-background-radius: 8; -fx-padding: 12 14; -fx-cursor: hand; -fx-border-color: #cbd5e0; -fx-border-radius: 8; -fx-border-width: 1.5;"
                                        text="⚙ Configurar dueños..." />
                                <Label fx:id="lblOwnersSummary"
                                       style="-fx-font-size: 12px; -fx-text-fill: #718096;"
                                       text="Sin dueños seleccionados" wrapText="true"/>
                            </VBox>

                        </VBox>
                    </ScrollPane>

                    <VBox spacing="12" style="-fx-padding: 8 0 0 0;">
                  <Button maxWidth="Infinity" onAction="#onCreate" style="-fx-background-color: #48bb78; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: 600; -fx-background-radius: 8; -fx-padding: 14; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(72, 187, 120, 0.3), 8, 0, 0, 3);" text="✓ Registrar Vehículo" />
                        <HBox spacing="10">
                     <Button maxWidth="Infinity" onAction="#onUpdate" prefHeight="47.0" prefWidth="337.0" style="-fx-background-color: #4299e1; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: 600; -fx-background-radius: 8; -fx-padding: 14; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(72, 187, 120, 0.3), 8, 0, 0, 3);" text="↻  Actualizar" />
                     <Button maxWidth="Infinity" onAction="#onDelete" prefHeight="47.0" prefWidth="322.0" style="-fx-background-color: #f56565; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: 600; -fx-background-radius: 8; -fx-padding: 14; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(72, 187, 120, 0.3), 8, 0, 0, 3);" text="🗑 Eliminar" />
                        </HBox>
                        <Button maxWidth="Infinity" onAction="#onClear" style="-fx-background-color: #edf2f7; -fx-text-fill: #4a5568; -fx-font-size: 13px; -fx-font-weight: 600; -fx-background-radius: 8; -fx-padding: 12; -fx-cursor: hand; -fx-border-color: #cbd5e0; -fx-border-radius: 8; -fx-border-width: 1.5; -fx-effect: dropshadow(gaussian, rgba(72, 187, 120, 0.3), 8, 0, 0, 3);" text="⟲ Limpiar Formulario" />
                    </VBox>
                </VBox>
            </VBox>
            
            <VBox spacing="0" style="-fx-background-color: #f0f4f8;" HBox.hgrow="ALWAYS">
                <VBox spacing="20" style="-fx-padding: 24;">
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2d3748;" text="Lista de Vehículos" />
                            <Label style="-fx-font-size: 12px; -fx-text-fill: #718096;" />
                        </VBox>
                        <TextField fx:id="tfSearch" prefHeight="40" promptText="🔍 Buscar vehículo..." style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #cbd5e0;                                           -fx-border-radius: 8; -fx-border-width: 1.5; -fx-padding: 10 14; -fx-font-size: 13px;                                          -fx-pref-width: 300;" />
                        <Button onAction="#onRefresh" style="-fx-background-color: white; -fx-text-fill: #4a5568; -fx-font-size: 13px;                                        -fx-font-weight: 600; -fx-background-radius: 8; -fx-padding: 10 20; -fx-cursor: hand;                                        -fx-border-color: #cbd5e0; -fx-border-radius: 8; -fx-border-width: 1.5;" text="↻ Refrescar" />
                    </HBox>
                    
                    <TableView fx:id="tableVehicles" onMouseClicked="#selectVehicleOnMouseClicked" style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #e2e8f0;                                      -fx-border-radius: 12; -fx-border-width: 1; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 6, 0, 0, 2);" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colPlate" prefWidth="120" text="Placa" />
                            <TableColumn fx:id="colBrand" prefWidth="150" text="Marca" />
                            <TableColumn fx:id="colModel" prefWidth="150" text="Modelo" />
                            <TableColumn fx:id="colColor" prefWidth="120" text="Color" />
                            <TableColumn fx:id="colType" prefWidth="120" text="Tipo" />
                        </columns>
                        <placeholder>
                            <VBox alignment="CENTER" spacing="12" style="-fx-padding: 40;">
                                <Label style="-fx-font-size: 48px;" text="🚗" />
                                <Label style="-fx-font-size: 16px; -fx-font-weight: 600; -fx-text-fill: #4a5568;" text="No hay vehículos registrados" />
                            </VBox>
                        </placeholder>
                    </TableView>
                    
                    <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 8 0 0 0;">
                        <Label style="-fx-font-size: 12px; -fx-text-fill: #718096;" text="Total de registros:" />
                        <Label fx:id="lblTotalRecords" style="-fx-font-size: 12px; -fx-font-weight: 700; -fx-text-fill: #2d3748;" text="0" />
                    </HBox>
                </VBox>
            </VBox>
        </HBox>
    </center>
</BorderPane>
