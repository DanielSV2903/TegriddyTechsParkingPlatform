<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.tegriddytechs.parkingplatform.tegriddytechsparkingplatform.view.ParkingLotCrudController"
            style="-fx-background-color: #f0f4f8;">

    <top>
        <VBox style="-fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
            <HBox alignment="CENTER_LEFT" spacing="16" style="-fx-padding: 18 24;">
                <Circle radius="8" style="-fx-fill: #3182ce;"/>
                <Label text="Gestión de Parqueaderos"
                       style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2d3748;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="← Volver" onAction="#goBack"
                        style="-fx-background-color: #edf2f7; -fx-text-fill: #4a5568; -fx-font-size: 13px;
                               -fx-font-weight: 600; -fx-background-radius: 8; -fx-padding: 10 20; -fx-cursor: hand;"/>
            </HBox>
            <Separator style="-fx-background-color: #e2e8f0;"/>
        </VBox>
    </top>

    <center>
        <HBox spacing="0">
            <VBox spacing="0" style="-fx-pref-width: 420; -fx-background-color: white; 
                                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 2, 0);">
                <VBox spacing="20" style="-fx-padding: 24;">
                    <VBox spacing="8">
                        <Label text="Formulario de Parqueadero"
                               style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2d3748;"/>
                        <Label text="Configure la información del parqueadero"
                               style="-fx-font-size: 12px; -fx-text-fill: #718096;"/>
                    </VBox>
                    
                    <Separator style="-fx-background-color: #e2e8f0;"/>
                    
                    <ScrollPane fitToWidth="true" style="-fx-background: transparent;">
                        <VBox spacing="20" style="-fx-padding: 4 2;">
                            <VBox spacing="8">
                                <Label text="ID del Parqueadero" style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #4a5568;"/>
                                <TextField fx:id="tfId" promptText="Identificador único"
                                          style="-fx-background-color: #f7fafc; -fx-background-radius: 8; -fx-border-color: #cbd5e0; 
                                                 -fx-border-radius: 8; -fx-border-width: 1.5; -fx-padding: 12 14; -fx-font-size: 13px;" 
                                          prefHeight="42"/>
                            </VBox>
                            
                            <VBox spacing="8">
                                <Label text="Nombre del Parqueadero" style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #4a5568;"/>
                                <TextField fx:id="tfName" promptText="Ej: Parqueadero Centro"
                                          style="-fx-background-color: #f7fafc; -fx-background-radius: 8; -fx-border-color: #cbd5e0; 
                                                 -fx-border-radius: 8; -fx-border-width: 1.5; -fx-padding: 12 14; -fx-font-size: 13px;" 
                                          prefHeight="42"/>
                            </VBox>
                            
                            <VBox spacing="8">
                                <Label text="Dirección" style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #4a5568;"/>
                                <TextField fx:id="tfAddress" promptText="Dirección completa"
                                          style="-fx-background-color: #f7fafc; -fx-background-radius: 8; -fx-border-color: #cbd5e0; 
                                                 -fx-border-radius: 8; -fx-border-width: 1.5; -fx-padding: 12 14; -fx-font-size: 13px;" 
                                          prefHeight="42"/>
                            </VBox>
                            
                            <VBox spacing="8">
                                <Label text="Capacidad Total" style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #4a5568;"/>
                                <TextField fx:id="tfCapacity" promptText="Número de espacios"
                                          style="-fx-background-color: #f7fafc; -fx-background-radius: 8; -fx-border-color: #cbd5e0; 
                                                 -fx-border-radius: 8; -fx-border-width: 1.5; -fx-padding: 12 14; -fx-font-size: 13px;" 
                                          prefHeight="42"/>
                            </VBox>
                        </VBox>
                    </ScrollPane>
                    
                    <VBox spacing="12" style="-fx-padding: 8 0 0 0;">
                        <Button text="✓ Crear Parqueadero" onAction="#onCreate" maxWidth="Infinity"
                                style="-fx-background-color: linear-gradient(135deg, #63b3ed 0%, #3182ce 100%); -fx-text-fill: white; 
                                       -fx-font-size: 14px; -fx-font-weight: 600; -fx-background-radius: 8; -fx-padding: 14; -fx-cursor: hand;
                                       -fx-effect: dropshadow(gaussian, rgba(49, 130, 206, 0.3), 8, 0, 0, 3);"/>
                        <HBox spacing="10">
                            <Button text="↻ Actualizar" onAction="#onUpdate" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                                    style="-fx-background-color: linear-gradient(135deg, #4299e1 0%, #3182ce 100%); -fx-text-fill: white; 
                                           -fx-font-size: 13px; -fx-font-weight: 600; -fx-background-radius: 8; -fx-padding: 12; -fx-cursor: hand;"/>
                            <Button text="🗑 Eliminar" onAction="#onDelete" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                                    style="-fx-background-color: linear-gradient(135deg, #fc8181 0%, #e53e3e 100%); -fx-text-fill: white; 
                                           -fx-font-size: 13px; -fx-font-weight: 600; -fx-background-radius: 8; -fx-padding: 12; -fx-cursor: hand;"/>
                        </HBox>
                        <Button text="⟲ Limpiar Formulario" onAction="#onClear" maxWidth="Infinity"
                                style="-fx-background-color: #edf2f7; -fx-text-fill: #4a5568; -fx-font-size: 13px; -fx-font-weight: 600;
                                       -fx-background-radius: 8; -fx-padding: 12; -fx-cursor: hand; -fx-border-color: #cbd5e0;
                                       -fx-border-radius: 8; -fx-border-width: 1.5;"/>
                    </VBox>
                </VBox>
            </VBox>
            
            <VBox spacing="0" HBox.hgrow="ALWAYS" style="-fx-background-color: #f0f4f8;">
                <VBox spacing="20" style="-fx-padding: 24;">
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Lista de Parqueaderos" style="-fx-font-size: 16px; -fx-font-weight: 600; -fx-text-fill: #2d3748;"/>
                            <Label text="Busque y gestione sus parqueaderos" style="-fx-font-size: 12px; -fx-text-fill: #718096;"/>
                        </VBox>
                        <TextField fx:id="tfSearch" promptText="🔍 Buscar parqueadero..."
                                  style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #cbd5e0; -fx-border-radius: 8; 
                                         -fx-border-width: 1.5; -fx-padding: 10 14; -fx-font-size: 13px; -fx-pref-width: 300;" 
                                  prefHeight="40"/>
                        <Button text="↻ Refrescar" onAction="#onRefresh"
                                style="-fx-background-color: white; -fx-text-fill: #4a5568; -fx-font-size: 13px; -fx-font-weight: 600;
                                       -fx-background-radius: 8; -fx-padding: 10 20; -fx-cursor: hand; -fx-border-color: #cbd5e0;
                                       -fx-border-radius: 8; -fx-border-width: 1.5;"/>
                    </HBox>
                    
                    <TableView fx:id="tableParkingLots" VBox.vgrow="ALWAYS"
                              style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #e2e8f0;
                                     -fx-border-radius: 12; -fx-border-width: 1; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 6, 0, 0, 2);">
                        <columns>
                            <TableColumn text="ID" fx:id="colId" prefWidth="100"/>
                            <TableColumn text="Nombre" fx:id="colName" prefWidth="250"/>
                            <TableColumn text="Dirección" fx:id="colAddress" prefWidth="300"/>
                            <TableColumn text="Capacidad" fx:id="colCapacity" prefWidth="100"/>
                        </columns>
                        <placeholder>
                            <VBox alignment="CENTER" spacing="12" style="-fx-padding: 40;">
                                <Label text="🅿️" style="-fx-font-size: 48px;"/>
                                <Label text="No hay parqueaderos registrados" 
                                       style="-fx-font-size: 16px; -fx-font-weight: 600; -fx-text-fill: #4a5568;"/>
                            </VBox>
                        </placeholder>
                    </TableView>
                    
                    <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 8 0 0 0;">
                        <Label text="Total de registros:" style="-fx-font-size: 12px; -fx-text-fill: #718096;"/>
                        <Label fx:id="lblTotalRecords" text="0" style="-fx-font-size: 12px; -fx-font-weight: 700; -fx-text-fill: #2d3748;"/>
                    </HBox>
                </VBox>
            </VBox>
        </HBox>
    </center>
</BorderPane>
