<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<BorderPane style="-fx-background-color: #f0f4f8;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.tegriddytechs.parkingplatform.tegriddytechsparkingplatform.view.UserCrudControllerImproved">

    <!-- Barra Superior -->
    <top>
        <VBox style="-fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
            <HBox alignment="CENTER_LEFT" spacing="16" style="-fx-padding: 18 24;">
            <Circle fill="#3874a1" radius="24" />
                <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2d3748;" text="Gestión de Usuarios" />
                <Region HBox.hgrow="ALWAYS" />
                <Button onAction="#goBack" prefHeight="39.0" prefWidth="109.0" style="-fx-background-color: #edf2f7;                                 -fx-text-fill: #4a5568;                                 -fx-font-size: 13px;                                -fx-font-weight: 600;                                -fx-background-radius: 8;                                 -fx-padding: 10 20;                                -fx-cursor: hand;" text="← Volver" />
            </HBox>
            <Separator style="-fx-background-color: #e2e8f0;" />
        </VBox>
    </top>

    <center>
        <HBox spacing="0" style="-fx-background-color: #f0f4f8;">
            
            <!-- Panel Izquierdo: Formulario -->
            <VBox spacing="0" style="-fx-pref-width: 420; -fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 2, 0);">
                <VBox spacing="20" style="-fx-background-radius: 12; -fx-padding: 24; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">
                    
                    <!-- Título del Formulario -->
                    <VBox spacing="8">
                        <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2d3748;" text="Formulario de Usuario" />
                        <Label style="-fx-font-size: 12px; -fx-text-fill: #718096; -fx-wrap-text: true;" text="Complete los campos para crear o editar un usuario" />
                    </VBox>
                    
                    <Separator style="-fx-background-color: #e2e8f0;" />
                    
                    <!-- Contenedor con Scroll -->
                    <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent;">
                        <VBox spacing="20" style="-fx-padding: 4 2;">
                            
                            <!-- Campo ID -->
                            <VBox spacing="8">
                                <Label style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #4a5568;" text="ID del Usuario" />
                                <TextField fx:id="tfId" prefHeight="42" promptText="Ingrese el ID (numérico)" style="-fx-background-color: #f7fafc;                                                   -fx-background-radius: 8;                                                   -fx-border-color: #cbd5e0;                                                   -fx-border-radius: 8;                                                   -fx-border-width: 1.5;                                                  -fx-padding: 12 14;                                                  -fx-font-size: 13px;                                                  -fx-text-fill: #2d3748;" />
                            </VBox>
                            
                            <!-- Campo Nombre -->
                            <VBox spacing="8">
                                <Label style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #4a5568;" text="Nombre Completo" />
                                <TextField fx:id="tfName" prefHeight="42" promptText="Ingrese el nombre completo" style="-fx-background-color: #f7fafc;                                                   -fx-background-radius: 8;                                                   -fx-border-color: #cbd5e0;                                                   -fx-border-radius: 8;                                                   -fx-border-width: 1.5;                                                  -fx-padding: 12 14;                                                  -fx-font-size: 13px;                                                  -fx-text-fill: #2d3748;" />
                            </VBox>
                            
                            <!-- Campo Username -->
                            <VBox spacing="8">
                                <Label style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #4a5568;" text="Nombre de Usuario" />
                                <TextField fx:id="tfUsername" prefHeight="42" promptText="Ingrese el nombre de usuario" style="-fx-background-color: #f7fafc;                                                   -fx-background-radius: 8;                                                   -fx-border-color: #cbd5e0;                                                   -fx-border-radius: 8;                                                   -fx-border-width: 1.5;                                                  -fx-padding: 12 14;                                                  -fx-font-size: 13px;                                                  -fx-text-fill: #2d3748;" />
                            </VBox>
                            
                            <!-- Campo Password -->
                            <VBox spacing="8">
                                <Label style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #4a5568;" text="Contraseña" />
                                <PasswordField fx:id="tfPassword" prefHeight="42" promptText="Ingrese la contraseña" style="-fx-background-color: #f7fafc;                                                       -fx-background-radius: 8;                                                       -fx-border-color: #cbd5e0;                                                       -fx-border-radius: 8;                                                       -fx-border-width: 1.5;                                                      -fx-padding: 12 14;                                                      -fx-font-size: 13px;                                                      -fx-text-fill: #2d3748;" />
                            </VBox>
                            
                            <!-- Campo Rol -->
                            <VBox spacing="8">
                                <Label style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #4a5568;" text="Rol del Usuario" />
                                <ComboBox fx:id="cbRole" maxWidth="Infinity" prefHeight="42" promptText="Seleccione el rol" style="-fx-background-color: #f7fafc;                                                  -fx-background-radius: 8;                                                  -fx-border-color: #cbd5e0;                                                  -fx-border-radius: 8;                                                  -fx-border-width: 1.5;                                                 -fx-padding: 8 14;                                                 -fx-font-size: 13px;                                                 -fx-text-fill: #2d3748;" />
                            </VBox>
                            
                        </VBox>
                    </ScrollPane>
                    
                    <!-- Botones de Acción -->
                    <VBox spacing="12" style="-fx-padding: 8 0 0 0;">
                  <Button maxWidth="Infinity" onAction="#onCreate" style="-fx-background-color: #48bb78; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: 600; -fx-background-radius: 8; -fx-padding: 14; -fx-cursor: hand;" text="✓ Crear Usuario" />
                        
                        <HBox spacing="10">
                     <Button maxWidth="Infinity" onAction="#onUpdate" prefHeight="47.0" prefWidth="313.0" style="-fx-background-color: #4299e1; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: 600; -fx-background-radius: 8; -fx-padding: 14; -fx-cursor: hand;" text="↻  Actualizar" />
                     <Button maxWidth="Infinity" onAction="#onDelete" prefHeight="47.0" prefWidth="302.0" style="-fx-background-color: #f56565; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: 600; -fx-background-radius: 8; -fx-padding: 14; -fx-cursor: hand;" text="🗑 Eliminar" />
                        </HBox>
                        
                        <Button maxWidth="Infinity" onAction="#onClear" style="-fx-background-color: #edf2f7;                                         -fx-text-fill: #4a5568;                                         -fx-font-size: 13px;                                        -fx-font-weight: 600;                                        -fx-background-radius: 8;                                         -fx-padding: 12;                                        -fx-cursor: hand;                                        -fx-border-color: #cbd5e0;                                        -fx-border-radius: 8;                                        -fx-border-width: 1.5;" text="⟲ Limpiar Formulario" />
                    </VBox>
                    
                </VBox>
            </VBox>
            
            <!-- Panel Derecho: Lista/Tabla -->
            <VBox spacing="0" style="-fx-background-color: #f0f4f8;" HBox.hgrow="ALWAYS">
                <VBox spacing="20" style="-fx-padding: 24;">
                    
                    <!-- Barra de Búsqueda y Acciones -->
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2d3748;" text="Lista de Usuarios" />
                            <Label style="-fx-font-size: 12px; -fx-text-fill: #718096;" text="Busque y seleccione usuarios para editarlos" />
                        </VBox>
                        
                        <TextField fx:id="tfSearch" prefHeight="40" promptText="🔍 Buscar por ID, nombre o usuario..." style="-fx-background-color: white;                                           -fx-background-radius: 8;                                           -fx-border-color: #cbd5e0;                                           -fx-border-radius: 8;                                           -fx-border-width: 1.5;                                          -fx-padding: 10 14;                                          -fx-font-size: 13px;                                          -fx-pref-width: 320;" />
                        
                        <Button onAction="#onRefresh" style="-fx-background-color: white;                                         -fx-text-fill: #4a5568;                                         -fx-font-size: 13px;                                        -fx-font-weight: 600;                                        -fx-background-radius: 8;                                         -fx-padding: 10 20;                                        -fx-cursor: hand;                                        -fx-border-color: #cbd5e0;                                        -fx-border-radius: 8;                                        -fx-border-width: 1.5;" text="↻ Refrescar" />
                    </HBox>
                    
                    <!-- Tabla de Usuarios -->
                    <TableView fx:id="tableUsers" style="-fx-background-color: white;                                       -fx-background-radius: 12;                                       -fx-border-color: #e2e8f0;                                      -fx-border-radius: 12;                                      -fx-border-width: 1;                                      -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 6, 0, 0, 2);" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colId" prefWidth="80" style="-fx-alignment: CENTER;" text="ID" />
                            <TableColumn fx:id="colName" prefWidth="250" style="-fx-alignment: CENTER_LEFT;" text="Nombre Completo" />
                            <TableColumn fx:id="colUsername" prefWidth="200" style="-fx-alignment: CENTER_LEFT;" text="Usuario" />
                            <TableColumn fx:id="colRole" prefWidth="150" style="-fx-alignment: CENTER;" text="Rol" />
                        </columns>
                        <placeholder>
                            <VBox alignment="CENTER" spacing="12" style="-fx-padding: 40;">
                                <Label style="-fx-font-size: 48px;" text="📋" />
                                <Label style="-fx-font-size: 16px; -fx-font-weight: 600; -fx-text-fill: #4a5568;" text="No hay usuarios registrados" />
                                <Label style="-fx-font-size: 13px; -fx-text-fill: #718096;" text="Cree un nuevo usuario usando el formulario" />
                            </VBox>
                        </placeholder>
                    </TableView>
                    
                    <!-- Información de Registros -->
                    <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 8 0 0 0;">
                        <Label style="-fx-font-size: 12px; -fx-text-fill: #718096;" text="Total de registros:" />
                        <Label fx:id="lblTotalRecords" style="-fx-font-size: 12px; -fx-font-weight: 700; -fx-text-fill: #2d3748;" text="0" />
                    </HBox>
                    
                </VBox>
            </VBox>
            
        </HBox>
    </center>

</BorderPane>
