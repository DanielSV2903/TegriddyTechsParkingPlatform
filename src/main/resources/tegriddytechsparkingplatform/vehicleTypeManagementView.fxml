<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<BorderPane prefHeight="750.0" prefWidth="1200.0" style="-fx-background-color: #f0f4f8;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.tegriddytechs.parkingplatform.tegriddytechsparkingplatform.view.VehicleTypeCrudController">

    <!-- TOP BAR -->
    <top>
        <VBox style="-fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
            <HBox alignment="CENTER_LEFT" spacing="16" style="-fx-padding: 18 24;">
                <Circle fill="#805ad5" radius="24" />
                <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2d3748;" text="Gestión de Tipos de Vehículo" />
                <Region HBox.hgrow="ALWAYS" />
                <Button onAction="#goBack" prefHeight="39" prefWidth="105" style="-fx-background-color: #edf2f7; -fx-text-fill: #4a5568; -fx-font-size: 13px; -fx-font-weight: 600; -fx-background-radius: 8; -fx-padding: 10 20;" text="← Volver" />
            </HBox>
            <Separator style="-fx-background-color: #e2e8f0;" />
        </VBox>
    </top>

    <!-- CONTENIDO PRINCIPAL -->
    <center>
        <HBox spacing="24" style="-fx-padding: 24;">

            <!-- PANEL IZQUIERDO: FORMULARIO -->
            <VBox spacing="20" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2); -fx-padding: 24; -fx-pref-width: 400;">

                <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2d3748;" text="Información del Tipo" />
                <Separator style="-fx-background-color: #e2e8f0;" />

                <!-- Campos del formulario con estilo moderno -->
                <VBox spacing="16">
                    <VBox spacing="6">
                        <Label style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #4a5568;" text="ID" />
                        <TextField fx:id="tfId" promptText="Ingrese ID del tipo" style="-fx-background-color: #f7fafc; -fx-border-color: #e2e8f0; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 10; -fx-font-size: 13px;" />
                    </VBox>

                    <VBox spacing="6">
                        <Label style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #4a5568;" text="Descripción" />
                        <TextField fx:id="tfDescription" promptText="Ej: Automóvil compacto" style="-fx-background-color: #f7fafc; -fx-border-color: #e2e8f0; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 10; -fx-font-size: 13px;" />
                    </VBox>

                    <VBox spacing="6">
                        <Label style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #4a5568;" text="Cantidad de Llantas" />
                        <TextField fx:id="tfAmountOfTyres" promptText="Ej: 4" style="-fx-background-color: #f7fafc; -fx-border-color: #e2e8f0; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 10; -fx-font-size: 13px;" />
                    </VBox>

                    <VBox spacing="6">
                        <Label style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #4a5568;" text="Tarifa" />
                        <TextField fx:id="tfFee" promptText="Ej: 5000" style="-fx-background-color: #f7fafc; -fx-border-color: #e2e8f0; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 10; -fx-font-size: 13px;" />
                    </VBox>

                    <VBox spacing="6">
                        <Label style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #4a5568;" text="Tipo de Espacio" />
                        <ComboBox fx:id="cbSpaceType" maxWidth="Infinity" promptText="Seleccione tipo de espacio" style="-fx-background-color: #f7fafc; -fx-border-color: #e2e8f0; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 8; -fx-font-size: 13px;" />
                    </VBox>
                </VBox>

                <Separator style="-fx-background-color: #e2e8f0;" />

                <!-- Botones de acción con estilo moderno -->
                <HBox spacing="12">
                    <Button maxWidth="Infinity" onAction="#onCreate" style="-fx-background-color: linear-gradient(to right, #805ad5, #9f7aea); -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: 600; -fx-background-radius: 8; -fx-padding: 12 24;" text="Crear" HBox.hgrow="ALWAYS" />
                    <Button maxWidth="Infinity" onAction="#onClear" style="-fx-background-color: #edf2f7; -fx-text-fill: #4a5568; -fx-font-size: 13px; -fx-font-weight: 600; -fx-background-radius: 8; -fx-padding: 12 24;" text="Limpiar" HBox.hgrow="ALWAYS" />
                </HBox>
            </VBox>

            <!-- PANEL DERECHO: TABLA -->
            <VBox spacing="16" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2); -fx-padding: 24;" HBox.hgrow="ALWAYS">

                <!-- Header de la tabla -->
                <HBox alignment="CENTER_LEFT" spacing="16">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2d3748;" text="Lista de Tipos de Vehículo" />
                        <Label style="-fx-font-size: 12px; -fx-text-fill: #718096;" text="Consulta y administra los tipos de vehículo registrados" />
                    </VBox>
                    <Button onAction="#onRefresh" style="-fx-background-color: #edf2f7; -fx-text-fill: #4a5568; -fx-font-size: 13px; -fx-font-weight: 600; -fx-background-radius: 8; -fx-padding: 10 20;" text="🔄 Refrescar" />
                </HBox>

                <Separator style="-fx-background-color: #e2e8f0;" />

                <!-- Búsqueda -->
                <TextField fx:id="tfSearch" promptText="🔍 Buscar por descripción o tipo..." style="-fx-background-color: #f7fafc; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10 16; -fx-font-size: 13px;" />

                <!-- Tabla con estilo moderno -->
                <TableView fx:id="tableVehicleTypes" style="-fx-background-color: transparent; -fx-background-radius: 8;" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" prefWidth="80" text="ID" />
                        <TableColumn fx:id="colDescription" prefWidth="200" text="Descripción" />
                        <TableColumn fx:id="colTyres" prefWidth="100" text="Llantas" />
                        <TableColumn fx:id="colFee" prefWidth="120" text="Tarifa" />
                        <TableColumn fx:id="colSpaceType" prefWidth="150" text="Tipo de Espacio" />
                    </columns>
                </TableView>

                <!-- Total de registros -->
                <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 8 0 0 0;">
                    <Label style="-fx-font-size: 12px; -fx-text-fill: #718096;" text="Total de registros:" />
                    <Label fx:id="lblTotalRecords" style="-fx-font-size: 12px; -fx-font-weight: 700; -fx-text-fill: #2d3748;" text="0" />
                </HBox>
            </VBox>

        </HBox>
    </center>

</BorderPane>