<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane style="-fx-background-color: #f0f4f8;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.tegriddytechs.parkingplatform.tegriddytechsparkingplatform.view.CustomerCrudController">

    <top>
        <VBox style="-fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
            <HBox alignment="CENTER_LEFT" spacing="16" style="-fx-padding: 18 24;">
                <Circle radius="8" style="-fx-fill: #805ad5;" />
                <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2d3748;" text="Gestión de Clientes" />
                <Region HBox.hgrow="ALWAYS" />
                <Button onAction="#goBack" style="-fx-background-color: #edf2f7;                                 -fx-text-fill: #4a5568;                                 -fx-font-size: 13px;                                -fx-font-weight: 600;                                -fx-background-radius: 8;                                 -fx-padding: 10 20;                                -fx-cursor: hand;" text="← Volver" />
            </HBox>
            <Separator style="-fx-background-color: #e2e8f0;" />
        </VBox>
    </top>

    <center>
        <HBox spacing="0">
            
            <!-- Panel Izquierdo: Formulario -->
            <VBox spacing="0" style="-fx-pref-width: 420; -fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 2, 0);">
                <VBox spacing="20" style="-fx-padding: 24;">
                    
                    <VBox spacing="8">
                        <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2d3748;" text="Formulario de Cliente" />
                        <Label style="-fx-font-size: 12px; -fx-text-fill: #718096; -fx-wrap-text: true;" text="Complete los campos para crear o editar un cliente" />
                    </VBox>
                    
                    <Separator style="-fx-background-color: #e2e8f0;" />
                    
                    <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent;">
                        <VBox spacing="20" style="-fx-padding: 4 2;">
                            
                            <!-- Campo ID -->
                            <VBox spacing="8">
                                <Label style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #4a5568;" text="ID del Cliente" />
                                <TextField fx:id="tfId" prefHeight="42" promptText="Ingrese el ID (numérico)" style="-fx-background-color: #f7fafc;                                                   -fx-background-radius: 8;                                                   -fx-border-color: #cbd5e0;                                                   -fx-border-radius: 8;                                                   -fx-border-width: 1.5;                                                  -fx-padding: 12 14;                                                  -fx-font-size: 13px;" />
                            </VBox>
                            
                            <!-- Campo Nombre -->
                            <VBox spacing="8">
                                <Label style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #4a5568;" text="Nombre Completo" />
                                <TextField fx:id="tfName" prefHeight="42" promptText="Ingrese el nombre completo" style="-fx-background-color: #f7fafc;                                                   -fx-background-radius: 8;                                                   -fx-border-color: #cbd5e0;                                                   -fx-border-radius: 8;                                                   -fx-border-width: 1.5;                                                  -fx-padding: 12 14;                                                  -fx-font-size: 13px;" />
                            </VBox>
                            
                            <!-- Campo Edad -->
                            <VBox spacing="8">
                                <Label style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #4a5568;" text="Edad" />
                                <TextField fx:id="tfAge" prefHeight="42" promptText="Ingrese la edad" style="-fx-background-color: #f7fafc;                                                   -fx-background-radius: 8;                                                   -fx-border-color: #cbd5e0;                                                   -fx-border-radius: 8;                                                   -fx-border-width: 1.5;                                                  -fx-padding: 12 14;                                                  -fx-font-size: 13px;" />
                            </VBox>
                            
                            <!-- Campo Discapacidad -->
                            <VBox spacing="8">
                                <Label style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #4a5568;" text="Información Especial" />
                                <HBox alignment="CENTER_LEFT" prefHeight="42" spacing="10" style="-fx-background-color: #f7fafc;                                               -fx-background-radius: 8;                                               -fx-border-color: #cbd5e0;                                               -fx-border-radius: 8;                                               -fx-border-width: 1.5;                                              -fx-padding: 12 14;">
                                    <CheckBox fx:id="cbDisability" style="-fx-font-size: 13px; -fx-text-fill: #4a5568;" text="Cliente con discapacidad" />
                                </HBox>
                            </VBox>
                            
                        </VBox>
                    </ScrollPane>
                    
                    <!-- Botones -->
                    <VBox spacing="12" style="-fx-padding: 8 0 0 0;">
                  <Button maxWidth="Infinity" onAction="#onCreate" style="-fx-background-color: #48bb78; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: 600; -fx-background-radius: 8; -fx-padding: 14; -fx-cursor: hand;" text="✓ Crear Cliente" />
                        
                        <HBox spacing="10">
                     <Button maxWidth="Infinity" onAction="#onUpdate" prefHeight="47.0" prefWidth="223.0" style="-fx-background-color: #4299e1; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: 600; -fx-background-radius: 8; -fx-padding: 14; -fx-cursor: hand;" text="↻ Actualizar" />
                     <Button maxWidth="Infinity" onAction="#onDelete" prefHeight="47.0" prefWidth="207.0" style="-fx-background-color: #f56565; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: 600; -fx-background-radius: 8; -fx-padding: 14; -fx-cursor: hand;" text="🗑 Eliminar" />
                        </HBox>
                        
                        <Button maxWidth="Infinity" onAction="#onClear" style="-fx-background-color: #edf2f7;                                         -fx-text-fill: #4a5568;                                         -fx-font-size: 13px;                                        -fx-font-weight: 600;                                        -fx-background-radius: 8;                                         -fx-padding: 12;                                        -fx-cursor: hand;                                        -fx-border-color: #cbd5e0;                                        -fx-border-radius: 8;                                        -fx-border-width: 1.5;" text="⟲ Limpiar Formulario" />
                    </VBox>
                    
                </VBox>
            </VBox>
            
            <!-- Panel Derecho: Tabla -->
            <VBox spacing="0" style="-fx-background-color: #f0f4f8;" HBox.hgrow="ALWAYS">
                <VBox spacing="20" style="-fx-padding: 24;">
                    
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label style="-fx-font-size: 16px; -fx-font-weight: 600; -fx-text-fill: #2d3748;" text="Lista de Clientes" />
                            <Label style="-fx-font-size: 12px; -fx-text-fill: #718096;" text="Busque y seleccione clientes para editarlos" />
                        </VBox>
                        
                        <TextField fx:id="tfSearch" prefHeight="40" promptText="🔍 Buscar por ID o nombre..." style="-fx-background-color: white;                                           -fx-background-radius: 8;                                           -fx-border-color: #cbd5e0;                                           -fx-border-radius: 8;                                           -fx-border-width: 1.5;                                          -fx-padding: 10 14;                                          -fx-font-size: 13px;                                          -fx-pref-width: 300;" />
                        
                        <Button onAction="#onRefresh" style="-fx-background-color: white;                                         -fx-text-fill: #4a5568;                                         -fx-font-size: 13px;                                        -fx-font-weight: 600;                                        -fx-background-radius: 8;                                         -fx-padding: 10 20;                                        -fx-cursor: hand;                                        -fx-border-color: #cbd5e0;                                        -fx-border-radius: 8;                                        -fx-border-width: 1.5;" text="↻ Refrescar" />
                    </HBox>
                    
                    <TableView fx:id="tableCustomers" style="-fx-background-color: white;                                       -fx-background-radius: 12;                                       -fx-border-color: #e2e8f0;                                      -fx-border-radius: 12;                                      -fx-border-width: 1;                                      -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 6, 0, 0, 2);" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colId" prefWidth="80" text="ID" />
                            <TableColumn fx:id="colName" prefWidth="280" text="Nombre" />
                            <TableColumn fx:id="colAge" prefWidth="100" text="Edad" />
                            <TableColumn fx:id="colDisability" prefWidth="150" text="Discapacidad" />
                        </columns>
                        <placeholder>
                            <VBox alignment="CENTER" spacing="12" style="-fx-padding: 40;">
                                <Label style="-fx-font-size: 48px;" text="👥" />
                                <Label style="-fx-font-size: 16px; -fx-font-weight: 600; -fx-text-fill: #4a5568;" text="No hay clientes registrados" />
                                <Label style="-fx-font-size: 13px; -fx-text-fill: #718096;" text="Cree un nuevo cliente usando el formulario" />
                            </VBox>
                        </placeholder>
                    </TableView>
                    
                    <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 8 0 0 0;">
                        <Label style="-fx-font-size: 12px; -fx-text-fill: #718096;" text="Total de registros:" />
                        <Label fx:id="lblTotalRecords" style="-fx-font-size: 12px; -fx-font-weight: 700; -fx-text-fill: #2d3748;" text="0" />
                    </HBox>
                    
                </VBox>
            </VBox>
            
        </HBox>
    </center>

</BorderPane>
