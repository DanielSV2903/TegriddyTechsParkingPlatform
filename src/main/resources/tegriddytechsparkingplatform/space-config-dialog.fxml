<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.tegriddytechs.parkingplatform.tegriddytechsparkingplatform.view.ParkingSpaceConfigDialogController"
            style="-fx-background-color: #f0f4f8;">

    <!-- HEADER -->
    <top>
        <VBox spacing="18"
              style="-fx-background-color: white;
                     -fx-padding: 20 24;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 6, 0, 0, 2);">

            <Label text="Configuración de espacios del lote"
                   style="-fx-font-size: 18px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #2d3748;"/>

            <GridPane hgap="14" vgap="12">

                <columnConstraints>
                    <ColumnConstraints minWidth="220"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>

                <!-- Total -->
                <Label text="Total de espacios:"
                       style="-fx-font-weight: 600; -fx-text-fill: #4a5568;"
                       GridPane.rowIndex="0" GridPane.columnIndex="0"/>

                <Spinner fx:id="spTotalSpaces"
                         editable="true"
                         style="-fx-background-color: #f7fafc;
                                -fx-border-color: #e2e8f0;
                                -fx-border-radius: 6;
                                -fx-background-radius: 6;"
                         GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <!-- Preferenciales -->
                <Label text="Preferenciales (0–100):"
                       style="-fx-font-weight: 600; -fx-text-fill: #4a5568;"
                       GridPane.rowIndex="1" GridPane.columnIndex="0"/>

                <Spinner fx:id="spPreferentialPercent"
                         editable="true"
                         style="-fx-background-color: #f7fafc;
                                -fx-border-color: #e2e8f0;
                                -fx-border-radius: 6;
                                -fx-background-radius: 6;"
                         GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <!-- Calculados -->
                <Label text="Preferenciales calculados:"
                       style="-fx-font-weight: 600; -fx-text-fill: #4a5568;"
                       GridPane.rowIndex="2" GridPane.columnIndex="0"/>

                <Label fx:id="lblPreferentialCount"
                       text="0"
                       style="-fx-text-fill: #2d3748; -fx-font-weight: bold;"
                       GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <!-- Suma -->
                <Label text="Suma por tipo:"
                       style="-fx-font-weight: 600; -fx-text-fill: #4a5568;"
                       GridPane.rowIndex="3" GridPane.columnIndex="0"/>

                <HBox spacing="10"
                      alignment="CENTER_LEFT"
                      GridPane.rowIndex="3" GridPane.columnIndex="1">

                    <Label fx:id="lblSumByType"
                           text="0"
                           style="-fx-text-fill: #2d3748; -fx-font-weight: bold;"/>

                    <Label text="| Restantes:"
                           style="-fx-text-fill: #718096;"/>

                    <Label fx:id="lblRemaining"
                           text="0"
                           style="-fx-text-fill: #4299e1; -fx-font-weight: bold;"/>
                </HBox>

                <!-- Validación -->
                <Label fx:id="lblValidation"
                       text=""
                       visible="false"
                       managed="false"
                       style="-fx-text-fill: #f56565;
                              -fx-background-color: #fff5f5;
                              -fx-border-color: #feb2b2;
                              -fx-border-radius: 6;
                              -fx-background-radius: 6;
                              -fx-padding: 8 10;
                              -fx-font-size: 12px;"
                       GridPane.rowIndex="4"
                       GridPane.columnIndex="0"
                       GridPane.columnSpan="2"/>

            </GridPane>
        </VBox>
    </top>

    <!-- TABLE SECTION -->
    <center>
        <VBox spacing="16"
              style="-fx-padding: 20 24;">

            <Label text="Espacios por tipo de vehículo:"
                   style="-fx-font-weight: 600;
                          -fx-text-fill: #2d3748;"/>

            <TableView fx:id="tblTypes"
                       editable="true"
                       prefHeight="280"
                       style="-fx-background-color: white;
                              -fx-border-color: #e2e8f0;
                              -fx-border-radius: 8;
                              -fx-background-radius: 8;
                              -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 5, 0, 0, 2);">

                <columns>
                    <TableColumn fx:id="colTypeName"
                                 text="Tipo"
                                 prefWidth="320"/>
                    <TableColumn fx:id="colCount"
                                 text="Cantidad"
                                 prefWidth="140"/>
                </columns>
            </TableView>

            <!-- BOTONES -->
            <HBox spacing="10" alignment="CENTER_RIGHT">

                <Button fx:id="btnAutoDistribute"
                        text="Auto-distribuir restantes"
                        style="-fx-background-color: #edf2f7;
                               -fx-text-fill: #4a5568;
                               -fx-font-weight: 600;
                               -fx-background-radius: 8;
                               -fx-padding: 8 16;"
                        onAction="#onAutoDistribute"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Button text="Cancelar"
                        style="-fx-background-color: #edf2f7;
                               -fx-text-fill: #4a5568;
                               -fx-font-weight: 600;
                               -fx-background-radius: 8;
                               -fx-padding: 8 16;"
                        onAction="#onCancel"/>

                <Button fx:id="btnApply"
                        text="Aplicar"
                        defaultButton="true"
                        style="-fx-background-color: #4299e1;
                               -fx-text-fill: white;
                               -fx-font-weight: 600;
                               -fx-background-radius: 8;
                               -fx-padding: 8 20;"
                        onAction="#onApply"/>
            </HBox>

        </VBox>
    </center>

</BorderPane>
