<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane style="-fx-background-color: #f0f4f8;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.tegriddytechs.parkingplatform.tegriddytechsparkingplatform.view.ParkingSpaceCrudController">

    <top>
        <VBox style="-fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
            <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-padding: 20 28;">
                <HBox alignment="CENTER_LEFT" spacing="14">
                    <StackPane>
                        <Circle fill="#38a169" radius="24" />
                        <SVGPath content="M -6,0 L 0,-6 L 6,0 L 0,6 Z" fill="transparent" stroke="white" strokeWidth="1.8" />
                    </StackPane>
                    <VBox spacing="2">
                        <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2d3748;" text="Gestión de Espacios" />
                        <Label style="-fx-font-size: 12px; -fx-text-fill: #718096;" text="Administra los espacios de estacionamiento" />
                    </VBox>
                </HBox>
                <Region HBox.hgrow="ALWAYS" />
            <Button onAction="#goBack" prefHeight="39.0" prefWidth="110.0" style="-fx-background-color: #edf2f7;                                 -fx-text-fill: #4a5568;                                 -fx-font-size: 13px;                                -fx-font-weight: 600;                                -fx-background-radius: 8;                                 -fx-padding: 10 20;                                -fx-cursor: hand;" text="← Volver" />
            </HBox>
            <Separator style="-fx-background-color: #e2e8f0;" />
        </VBox>
    </top>

    <center>
        <HBox spacing="24" style="-fx-padding: 24 28;">
            <!-- Formulario izquierdo -->
            <VBox prefWidth="380" spacing="20" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 24; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">
                <Label style="-fx-font-size: 16px; -fx-font-weight: 600; -fx-text-fill: #2d3748;" text="Datos del Espacio" />

                <VBox spacing="16">
                    <VBox spacing="6">
                        <Label style="-fx-font-size: 13px; -fx-font-weight: 500; -fx-text-fill: #4a5568;" text="ID Espacio" />
                        <TextField fx:id="tfSpaceId" prefHeight="42" style="-fx-background-color: #f7fafc; -fx-background-radius: 8; -fx-border-color: #cbd5e0; -fx-border-radius: 8; -fx-border-width: 1.5; -fx-padding: 12 14; -fx-font-size: 13px; -fx-text-fill: #2d3748;" />
                    </VBox>

                    <VBox spacing="6">
                        <Label style="-fx-font-size: 13px; -fx-font-weight: 500; -fx-text-fill: #4a5568;" text="ID Parqueadero" />
                        <TextField fx:id="tfParkingLotId" prefHeight="42" style="-fx-background-color: #f7fafc; -fx-background-radius: 8; -fx-border-color: #cbd5e0; -fx-border-radius: 8; -fx-border-width: 1.5; -fx-padding: 12 14; -fx-font-size: 13px; -fx-text-fill: #2d3748;" />
                    </VBox>

                    <VBox spacing="6">
                        <Label style="-fx-font-size: 13px; -fx-font-weight: 500; -fx-text-fill: #4a5568;" text="Tipo de Espacio" />
                        <ComboBox fx:id="cbSpaceType" maxWidth="Infinity" prefHeight="42" style="-fx-background-color: #f7fafc; -fx-background-radius: 8; -fx-border-color: #cbd5e0; -fx-border-radius: 8; -fx-border-width: 1.5; -fx-padding: 8 14; -fx-font-size: 13px;" />
                    </VBox>

                    <VBox spacing="6">
                        <Label style="-fx-font-size: 13px; -fx-font-weight: 500; -fx-text-fill: #4a5568;" text="Estado" />
                        <ComboBox fx:id="cbStatus" maxWidth="Infinity" prefHeight="42" style="-fx-background-color: #f7fafc; -fx-background-radius: 8; -fx-border-color: #cbd5e0; -fx-border-radius: 8; -fx-border-width: 1.5; -fx-padding: 8 14; -fx-font-size: 13px;" />
                    </VBox>
                </VBox>

                <VBox spacing="12" style="-fx-padding: 20 0 0 0;">
                    <Button maxWidth="Infinity" onAction="#onCreate" style="-fx-background-color: #48bb78; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: 600; -fx-background-radius: 8; -fx-padding: 14; -fx-cursor: hand;" text="✓ Crear Espacio" />
                    <Button maxWidth="Infinity" onAction="#onUpdate" style="-fx-background-color: #4299e1; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: 600; -fx-background-radius: 8; -fx-padding: 14; -fx-cursor: hand;" text="↻  Actualizar Espacio" />
                    <Button maxWidth="Infinity" onAction="#onDelete" style="-fx-background-color: #f56565; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: 600; -fx-background-radius: 8; -fx-padding: 14; -fx-cursor: hand;" text="🗑 Eliminar Espacio" />
               <Button maxWidth="Infinity" onAction="#onClear" style="-fx-background-color: #edf2f7;                                         -fx-text-fill: #4a5568;                                         -fx-font-size: 13px;                                        -fx-font-weight: 600;                                        -fx-background-radius: 8;                                         -fx-padding: 12;                                        -fx-cursor: hand;                                        -fx-border-color: #cbd5e0;                                        -fx-border-radius: 8;                                        -fx-border-width: 1.5;" text="⟲ Limpiar Formulario" />
                </VBox>
            </VBox>

            <!-- Tabla derecha -->
            <VBox spacing="16" style="-fx-pref-width: 700;">
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2d3748;" text="Lista de Espacios" />
                    <Region HBox.hgrow="ALWAYS" />
                    <TextField fx:id="tfSearch" prefHeight="38" prefWidth="240" promptText="Buscar por ID o tipo..." style="-fx-background-color: #f7fafc; -fx-background-radius: 8; -fx-border-color: #cbd5e0; -fx-border-radius: 8; -fx-border-width: 1.5; -fx-padding: 10 14; -fx-font-size: 13px; -fx-text-fill: #2d3748;" />
               <Button onAction="#onRefresh" style="-fx-background-color: white;                                         -fx-text-fill: #4a5568;                                         -fx-font-size: 13px;                                        -fx-font-weight: 600;                                        -fx-background-radius: 8;                                         -fx-padding: 10 20;                                        -fx-cursor: hand;                                        -fx-border-color: #cbd5e0;                                        -fx-border-radius: 8;                                        -fx-border-width: 1.5;" text="↻ Refrescar" />
                </HBox>

                <TableView fx:id="tableSpaces" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">
                    <columns>
                        <TableColumn fx:id="colSpaceId" prefWidth="100" text="ID Espacio" />
                        <TableColumn fx:id="colParkingLotId" prefWidth="120" text="ID Parqueadero" />
                        <TableColumn fx:id="colSpaceType" prefWidth="120" text="Tipo" />
                        <TableColumn fx:id="colStatus" prefWidth="100" text="Estado" />
                    </columns>
                </TableView>
            <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 8 0 0 0;">
               <children>
                  <Label style="-fx-font-size: 12px; -fx-text-fill: #718096;" text="Total de registros:" />
                  <Label fx:id="lblTotalRecords" style="-fx-font-size: 12px; -fx-font-weight: 700; -fx-text-fill: #2d3748;" text="0" />
               </children>
            </HBox>
            </VBox>
        </HBox>
    </center>
</BorderPane>
