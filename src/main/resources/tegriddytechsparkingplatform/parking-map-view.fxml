<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane xmlns="http://javafx.com/javafx/21" 
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.tegriddytechs.parkingplatform.tegriddytechsparkingplatform.view.ParkingMapController"
            style="-fx-background-color: #f0f4f8;"
            prefWidth="1200" prefHeight="800">

    <!-- TOP BAR -->
    <top>
        <VBox style="-fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
            <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-padding: 16 28;">
                
                <HBox alignment="CENTER_LEFT" spacing="14">
                    <Circle radius="22" fill="#3182ce"/>
                    <VBox spacing="2">
                        <Label text="Visualizacion de Parqueaderos"
                               style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2d3748;"/>
                        <Label text="Mapa Grafico de Espacios"
                               style="-fx-font-size: 12px; -fx-text-fill: #718096;"/>
                    </VBox>
                </HBox>

                <VBox spacing="8" style="-fx-padding: 0 0 0 40;">
                    <Label text="Seleccionar Parqueadero"
                           style="-fx-font-size: 12px; -fx-text-fill: #718096;"/>
                    <ComboBox fx:id="cbParkingLot" prefWidth="300"
                              style="-fx-background-color: white; -fx-border-color: #cbd5e0; 
                                     -fx-border-radius: 8; -fx-background-radius: 8; 
                                     -fx-font-size: 13px; -fx-padding: 8;"/>
                </VBox>

                <Button text="Refrescar" onAction="#onRefresh"
                        style="-fx-background-color: linear-gradient(to right, #3182ce, #4299e1); 
                               -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: 600;
                               -fx-background-radius: 8; -fx-padding: 10 20; -fx-cursor: hand;"/>
            </HBox>
            <Separator style="-fx-background-color: #e2e8f0;"/>
        </VBox>
    </top>

    <!-- CONTENIDO PRINCIPAL -->
    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true" 
                    style="-fx-background: transparent; -fx-background-color: transparent;">
            <VBox spacing="20" style="-fx-padding: 24;">
                
                <!-- ESTADISTICAS -->
                <HBox spacing="20" alignment="CENTER">
                    
                    <!-- Tarjeta: Nombre -->
                    <VBox spacing="8" alignment="CENTER"
                          style="-fx-background-color: white; -fx-background-radius: 12; 
                                 -fx-padding: 20; -fx-pref-width: 250;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">
                        <Label text="Parqueadero"
                               style="-fx-font-size: 13px; -fx-text-fill: #718096;"/>
                        <Label fx:id="lblParkingName" text="No seleccionado"
                               style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2d3748;"/>
                    </VBox>
                    
                    <!-- Tarjeta: Total Espacios -->
                    <VBox spacing="8" alignment="CENTER"
                          style="-fx-background-color: white; -fx-background-radius: 12; 
                                 -fx-padding: 20; -fx-pref-width: 180;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">
                        <HBox alignment="CENTER" spacing="10">
                            <Circle radius="18" fill="#e6f2ff"/>
                            <VBox spacing="2" alignment="CENTER">
                                <Label text="Total Espacios"
                                       style="-fx-font-size: 11px; -fx-text-fill: #718096;"/>
                                <Label fx:id="lblTotalSpaces" text="0"
                                       style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #3182ce;"/>
                            </VBox>
                        </HBox>
                    </VBox>
                    
                    <!-- Tarjeta: Espacios Ocupados -->
                    <VBox spacing="8" alignment="CENTER"
                          style="-fx-background-color: white; -fx-background-radius: 12; 
                                 -fx-padding: 20; -fx-pref-width: 180;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">
                        <HBox alignment="CENTER" spacing="10">
                            <Circle radius="18" fill="#ffe6e6"/>
                            <VBox spacing="2" alignment="CENTER">
                                <Label text="Ocupados"
                                       style="-fx-font-size: 11px; -fx-text-fill: #718096;"/>
                                <Label fx:id="lblOccupiedSpaces" text="0"
                                       style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #e53e3e;"/>
                            </VBox>
                        </HBox>
                    </VBox>
                    
                    <!-- Tarjeta: Espacios Disponibles -->
                    <VBox spacing="8" alignment="CENTER"
                          style="-fx-background-color: white; -fx-background-radius: 12; 
                                 -fx-padding: 20; -fx-pref-width: 180;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">
                        <HBox alignment="CENTER" spacing="10">
                            <Circle radius="18" fill="#e6ffed"/>
                            <VBox spacing="2" alignment="CENTER">
                                <Label text="Disponibles"
                                       style="-fx-font-size: 11px; -fx-text-fill: #718096;"/>
                                <Label fx:id="lblAvailableSpaces" text="0"
                                       style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #38a169;"/>
                            </VBox>
                        </HBox>
                    </VBox>
                    
                </HBox>

                <!-- LEYENDA -->
                <Pane fx:id="legendPanel"
                      style="-fx-background-color: white; -fx-background-radius: 12; 
                             -fx-padding: 16; 
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);"/>

                <!-- MAPA DEL PARQUEADERO -->
                <VBox spacing="12" alignment="CENTER"
                      style="-fx-background-color: white; -fx-background-radius: 12; 
                             -fx-padding: 24;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">
                    
                    <Label text="Mapa de Espacios"
                           style="-fx-font-size: 16px; -fx-font-weight: 600; -fx-text-fill: #2d3748;"/>
                    
                    <!-- Grid donde se mostrará la matriz de espacios -->
                    <GridPane fx:id="gridParkingMap" alignment="CENTER"
                              hgap="4" vgap="4"
                              style="-fx-padding: 20;">
                    </GridPane>
                    
                    <Label text="Haga clic en cualquier espacio para ver detalles"
                           style="-fx-font-size: 12px; -fx-text-fill: #718096; -fx-font-style: italic;"/>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
