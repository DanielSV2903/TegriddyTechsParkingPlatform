<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ButtonBar?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.tegriddytechs.parkingplatform.tegriddytechsparkingplatform.view.AdminSelectDialogController"
      spacing="12" prefWidth="420">

    <padding>
        <Insets top="14" right="14" bottom="14" left="14"/>
    </padding>

    <Label text="Seleccione un administrador"/>

    <ComboBox fx:id="cbAdmins" prefWidth="380"/>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Cancelar" onAction="#onCancel"/>
        <Button text="Aceptar" defaultButton="true" onAction="#onOk"/>
    </HBox>
</VBox>