<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.tegriddytechs.parkingplatform.tegriddytechsparkingplatform.view.RateCrudController"
            style="-fx-background-color: #f0f4f8;">

    <top>
        <VBox style="-fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
            <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-padding: 20 28;">
                <HBox alignment="CENTER_LEFT" spacing="14">
                    <StackPane>
                        <Circle radius="24" fill="#d53f8c"/>
                        <SVGPath content="M -2,-6 L -2,2 M 2,-6 L 2,2 M -6,2 L 6,2 L 6,6 L -6,6 Z"
                                 fill="transparent" stroke="white" strokeWidth="1.8"/>
                    </StackPane>
                    <VBox spacing="2">
                        <Label text="Gestión de Tarifas"
                               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2d3748;"/>
                        <Label text="Configura precios y tarifas del sistema"
                               style="-fx-font-size: 12px; -fx-text-fill: #718096;"/>
                    </VBox>
                </HBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Regresar al Menú" onAction="#goBack"
                        style="-fx-background-color: #f7fafc; -fx-text-fill: #d53f8c; -fx-font-size: 13px; -fx-font-weight: 600; -fx-background-radius: 8; -fx-padding: 10 20; -fx-cursor: hand; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-border-width: 1;"/>
            </HBox>
            <Separator style="-fx-background-color: #e2e8f0;"/>
        </VBox>
    </top>

    <center>
        <HBox spacing="24" style="-fx-padding: 24 28;">
            <!-- Formulario izquierdo -->
            <VBox spacing="20" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 24; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);" prefWidth="380">
                <Label text="Datos de la Tarifa"
                       style="-fx-font-size: 16px; -fx-font-weight: 600; -fx-text-fill: #2d3748;"/>

                <VBox spacing="16">
                    <VBox spacing="6">
                        <Label text="ID Tarifa"
                               style="-fx-font-size: 13px; -fx-font-weight: 500; -fx-text-fill: #4a5568;"/>
                        <TextField fx:id="tfRateId"
                                   style="-fx-background-color: #f7fafc; -fx-background-radius: 8; -fx-border-color: #cbd5e0; -fx-border-radius: 8; -fx-border-width: 1.5; -fx-padding: 12 14; -fx-font-size: 13px; -fx-text-fill: #2d3748;"
                                   prefHeight="42"/>
                    </VBox>

                    <VBox spacing="6">
                        <Label text="Tipo de Vehículo"
                               style="-fx-font-size: 13px; -fx-font-weight: 500; -fx-text-fill: #4a5568;"/>
                        <ComboBox fx:id="cbVehicleType"
                                  style="-fx-background-color: #f7fafc; -fx-background-radius: 8; -fx-border-color: #cbd5e0; -fx-border-radius: 8; -fx-border-width: 1.5; -fx-padding: 8 14; -fx-font-size: 13px;"
                                  prefHeight="42" maxWidth="Infinity"/>
                    </VBox>

                    <VBox spacing="6">
                        <Label text="Precio por Hora ($)"
                               style="-fx-font-size: 13px; -fx-font-weight: 500; -fx-text-fill: #4a5568;"/>
                        <TextField fx:id="tfHourlyRate"
                                   style="-fx-background-color: #f7fafc; -fx-background-radius: 8; -fx-border-color: #cbd5e0; -fx-border-radius: 8; -fx-border-width: 1.5; -fx-padding: 12 14; -fx-font-size: 13px; -fx-text-fill: #2d3748;"
                                   prefHeight="42"/>
                    </VBox>

                    <VBox spacing="6">
                        <Label text="Precio por Día ($)"
                               style="-fx-font-size: 13px; -fx-font-weight: 500; -fx-text-fill: #4a5568;"/>
                        <TextField fx:id="tfDailyRate"
                                   style="-fx-background-color: #f7fafc; -fx-background-radius: 8; -fx-border-color: #cbd5e0; -fx-border-radius: 8; -fx-border-width: 1.5; -fx-padding: 12 14; -fx-font-size: 13px; -fx-text-fill: #2d3748;"
                                   prefHeight="42"/>
                    </VBox>

                    <VBox spacing="6">
                        <Label text="Descripción"
                               style="-fx-font-size: 13px; -fx-font-weight: 500; -fx-text-fill: #4a5568;"/>
                        <TextArea fx:id="taDescription"
                                  style="-fx-background-color: #f7fafc; -fx-background-radius: 8; -fx-border-color: #cbd5e0; -fx-border-radius: 8; -fx-border-width: 1.5; -fx-padding: 12 14; -fx-font-size: 13px; -fx-text-fill: #2d3748;"
                                  prefHeight="80" wrapText="true"/>
                    </VBox>
                </VBox>

                <VBox spacing="12" style="-fx-padding: 20 0 0 0;">
                    <Button text="Crear Tarifa" onAction="#onCreate"
                            style="-fx-background-color: #48bb78; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: 600; -fx-background-radius: 8; -fx-padding: 14; -fx-cursor: hand;"
                            maxWidth="Infinity"/>
                    <Button text="Actualizar Tarifa" onAction="#onUpdate"
                            style="-fx-background-color: #4299e1; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: 600; -fx-background-radius: 8; -fx-padding: 14; -fx-cursor: hand;"
                            maxWidth="Infinity"/>
                    <Button text="Eliminar Tarifa" onAction="#onDelete"
                            style="-fx-background-color: #f56565; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: 600; -fx-background-radius: 8; -fx-padding: 14; -fx-cursor: hand;"
                            maxWidth="Infinity"/>
                    <Button text="Limpiar Formulario" onAction="#onClear"
                            style="-fx-background-color: #f7fafc; -fx-text-fill: #4a5568; -fx-font-size: 13px; -fx-font-weight: 600; -fx-background-radius: 8; -fx-padding: 14; -fx-cursor: hand; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-border-width: 1;"
                            maxWidth="Infinity"/>
                </VBox>
            </VBox>

            <!-- Tabla derecha -->
            <VBox spacing="16" style="-fx-pref-width: 700;">
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label text="Lista de Tarifas"
                           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2d3748;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <TextField fx:id="tfSearch" promptText="Buscar por tipo o descripción..."
                               style="-fx-background-color: #f7fafc; -fx-background-radius: 8; -fx-border-color: #cbd5e0; -fx-border-radius: 8; -fx-border-width: 1.5; -fx-padding: 10 14; -fx-font-size: 13px; -fx-text-fill: #2d3748;"
                               prefHeight="38" prefWidth="240"/>
                    <Button text="Actualizar Tabla" onAction="#onRefresh"
                            style="-fx-background-color: #f7fafc; -fx-text-fill: #d53f8c; -fx-font-size: 13px; -fx-font-weight: 600; -fx-background-radius: 8; -fx-padding: 10 20; -fx-cursor: hand; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-border-width: 1;"/>
                </HBox>

                <TableView fx:id="tableRates"
                           style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">
                    <columns>
                        <TableColumn fx:id="colRateId" text="ID" prefWidth="80"/>
                        <TableColumn fx:id="colVehicleType" text="Tipo Vehículo" prefWidth="120"/>
                        <TableColumn fx:id="colHourlyRate" text="Precio/Hora" prefWidth="100"/>
                        <TableColumn fx:id="colDailyRate" text="Precio/Día" prefWidth="100"/>
                        <TableColumn fx:id="colDescription" text="Descripción" prefWidth="200"/>
                    </columns>
                </TableView>

                <HBox alignment="CENTER_LEFT">
                    <Label fx:id="lblTotalRecords" text="Total: 0 registros"
                           style="-fx-font-size: 13px; -fx-text-fill: #718096;"/>
                </HBox>
            </VBox>
        </HBox>
    </center>
</BorderPane>