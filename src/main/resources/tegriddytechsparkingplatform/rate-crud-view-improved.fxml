<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<BorderPane style="-fx-background-color: #f0f4f8;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.tegriddytechs.parkingplatform.tegriddytechsparkingplatform.view.RateCrudController">

    <top>
        <VBox style="-fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
            <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-padding: 20 28;">
                <HBox alignment="CENTER_LEFT" spacing="14">
                    <StackPane>
                        <Circle fill="#d53f8c" radius="24" />
                        <SVGPath content="M -2,-6 L -2,2 M 2,-6 L 2,2 M -6,2 L 6,2 L 6,6 L -6,6 Z" fill="transparent" stroke="white" strokeWidth="1.8" />
                    </StackPane>
                    <VBox spacing="2">
                        <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2d3748;" text="Gestión de Tarifas" />
                        <Label style="-fx-font-size: 12px; -fx-text-fill: #718096;" text="Configura precios y tarifas del sistema" />
                    </VBox>
                </HBox>
                <Region HBox.hgrow="ALWAYS" />
            <Button onAction="#goBack" prefHeight="39.0" prefWidth="110.0" style="-fx-background-color: #edf2f7;                                 -fx-text-fill: #4a5568;                                 -fx-font-size: 13px;                                -fx-font-weight: 600;                                -fx-background-radius: 8;                                 -fx-padding: 10 20;                                -fx-cursor: hand;" text="← Volver" />
            </HBox>
            <Separator style="-fx-background-color: #e2e8f0;" />
        </VBox>
    </top>

    <center>
        <HBox spacing="24" style="-fx-padding: 24 28;">
            <!-- Formulario izquierdo -->
            <VBox prefWidth="380" spacing="20" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 24; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">
                <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2d3748;" text="Datos de la Tarifa" />

                <VBox spacing="16">
                    <VBox spacing="6">
                        <Label style="-fx-font-size: 13px; -fx-font-weight: 500; -fx-text-fill: #4a5568;" text="ID Tarifa" />
                        <TextField fx:id="tfRateId" prefHeight="42" style="-fx-background-color: #f7fafc; -fx-background-radius: 8; -fx-border-color: #cbd5e0; -fx-border-radius: 8; -fx-border-width: 1.5; -fx-padding: 12 14; -fx-font-size: 13px; -fx-text-fill: #2d3748;" />
                    </VBox>

                    <VBox spacing="6">
                        <Label style="-fx-font-size: 13px; -fx-font-weight: 500; -fx-text-fill: #4a5568;" text="Tipo de Vehículo" />
                        <ComboBox fx:id="cbVehicleType" maxWidth="Infinity" prefHeight="42" style="-fx-background-color: #f7fafc; -fx-background-radius: 8; -fx-border-color: #cbd5e0; -fx-border-radius: 8; -fx-border-width: 1.5; -fx-padding: 8 14; -fx-font-size: 13px;" />
                    </VBox>

                    <VBox spacing="6">
                        <Label style="-fx-font-size: 13px; -fx-font-weight: 500; -fx-text-fill: #4a5568;" text="Precio por Hora (₡)" />
                        <TextField fx:id="tfHourlyRate" prefHeight="42" style="-fx-background-color: #f7fafc; -fx-background-radius: 8; -fx-border-color: #cbd5e0; -fx-border-radius: 8; -fx-border-width: 1.5; -fx-padding: 12 14; -fx-font-size: 13px; -fx-text-fill: #2d3748;" />
                    </VBox>

                    <VBox spacing="6">
                        <Label style="-fx-font-size: 13px; -fx-font-weight: 500; -fx-text-fill: #4a5568;" text="Precio por Día (₡)" />
                        <TextField fx:id="tfDailyRate" prefHeight="42" style="-fx-background-color: #f7fafc; -fx-background-radius: 8; -fx-border-color: #cbd5e0; -fx-border-radius: 8; -fx-border-width: 1.5; -fx-padding: 12 14; -fx-font-size: 13px; -fx-text-fill: #2d3748;" />
                    </VBox>

                    <VBox spacing="6">
                        <Label style="-fx-font-size: 13px; -fx-font-weight: 500; -fx-text-fill: #4a5568;" text="Descripción" />
                        <TextArea fx:id="taDescription" prefHeight="80" style="-fx-background-color: #f7fafc; -fx-background-radius: 8; -fx-border-color: #cbd5e0; -fx-border-radius: 8; -fx-border-width: 1.5; -fx-padding: 12 14; -fx-font-size: 13px; -fx-text-fill: #2d3748;" wrapText="true" />
                    </VBox>
                </VBox>

                <VBox spacing="12" style="-fx-padding: 20 0 0 0;">
                    <Button maxWidth="Infinity" onAction="#onCreate" style="-fx-background-color: #48bb78; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: 600; -fx-background-radius: 8; -fx-padding: 14; -fx-cursor: hand;" text="✓ Crear Tarifa" />
                    <Button maxWidth="Infinity" onAction="#onUpdate" style="-fx-background-color: #4299e1; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: 600; -fx-background-radius: 8; -fx-padding: 14; -fx-cursor: hand;" text="↻  Actualizar Tarifa" />
                    <Button maxWidth="Infinity" onAction="#onDelete" style="-fx-background-color: #f56565; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: 600; -fx-background-radius: 8; -fx-padding: 14; -fx-cursor: hand;" text="🗑 Eliminar Tarifa" />
                </VBox>
            <Button maxWidth="Infinity" onAction="#onClear" style="-fx-background-color: #edf2f7;                                         -fx-text-fill: #4a5568;                                         -fx-font-size: 13px;                                        -fx-font-weight: 600;                                        -fx-background-radius: 8;                                         -fx-padding: 12;                                        -fx-cursor: hand;                                        -fx-border-color: #cbd5e0;                                        -fx-border-radius: 8;                                        -fx-border-width: 1.5;" text="⟲ Limpiar Formulario" />
            </VBox>

            <!-- Tabla derecha -->
            <VBox spacing="16" style="-fx-pref-width: 700;">
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2d3748;" text="Lista de Tarifas" />
                    <Region HBox.hgrow="ALWAYS" />
                    <TextField fx:id="tfSearch" prefHeight="38" prefWidth="240" promptText="Buscar por tipo o descripción..." style="-fx-background-color: #f7fafc; -fx-background-radius: 8; -fx-border-color: #cbd5e0; -fx-border-radius: 8; -fx-border-width: 1.5; -fx-padding: 10 14; -fx-font-size: 13px; -fx-text-fill: #2d3748;" />
               <Button onAction="#onRefresh" style="-fx-background-color: white;                                         -fx-text-fill: #4a5568;                                         -fx-font-size: 13px;                                        -fx-font-weight: 600;                                        -fx-background-radius: 8;                                         -fx-padding: 10 20;                                        -fx-cursor: hand;                                        -fx-border-color: #cbd5e0;                                        -fx-border-radius: 8;                                        -fx-border-width: 1.5;" text="↻ Refrescar" />
                </HBox>

                <TableView fx:id="tableRates" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">
                    <columns>
                        <TableColumn fx:id="colRateId" prefWidth="80" text="ID" />
                        <TableColumn fx:id="colVehicleType" prefWidth="120" text="Tipo Vehículo" />
                        <TableColumn fx:id="colHourlyRate" prefWidth="100" text="Precio/Hora" />
                        <TableColumn fx:id="colDailyRate" prefWidth="100" text="Precio/Día" />
                        <TableColumn fx:id="colDescription" prefWidth="200" text="Descripción" />
                    </columns>
                </TableView>
            <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 8 0 0 0;">
               <children>
                  <Label style="-fx-font-size: 12px; -fx-text-fill: #718096;" text="Total de registros:" />
                  <Label fx:id="lblTotalRecords" style="-fx-font-size: 12px; -fx-font-weight: 700; -fx-text-fill: #2d3748;" text="0" />
               </children>
            </HBox>
            </VBox>
        </HBox>
    </center>
</BorderPane>
