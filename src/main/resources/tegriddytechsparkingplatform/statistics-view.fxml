<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<BorderPane style="-fx-background-color: #f0f4f8;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.tegriddytechs.parkingplatform.tegriddytechsparkingplatform.view.StatisticsController">

    <!-- HEADER -->
    <top>
        <VBox style="-fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
            <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-padding: 20 28;">
                <HBox alignment="CENTER_LEFT" spacing="14">
                    <StackPane>
                        <Circle fill="#805ad5" radius="24" />
                        <!-- Icono simple (rombo) como en tu patrón -->
                        <SVGPath content="M -6,0 L 0,-6 L 6,0 L 0,6 Z"
                                 fill="transparent" stroke="white" strokeWidth="1.8" />
                    </StackPane>

                    <VBox spacing="2">
                        <Label text="Estadísticas"
                               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2d3748;" />
                        <Label text="Indicadores clave del sistema de parqueos"
                               style="-fx-font-size: 12px; -fx-text-fill: #718096;" />
                    </VBox>
                </HBox>

                <Region HBox.hgrow="ALWAYS" />

                <Button text="← Volver"
                        onAction="#goBack"
                        prefHeight="39.0" prefWidth="110.0"
                        style="-fx-background-color: #edf2f7;
                               -fx-text-fill: #4a5568;
                               -fx-font-size: 13px;
                               -fx-font-weight: 600;
                               -fx-background-radius: 8;
                               -fx-padding: 10 20;
                               -fx-cursor: hand;" />
            </HBox>

            <Separator style="-fx-background-color: #e2e8f0;" />
        </VBox>
    </top>

    <!-- CONTENIDO -->
    <center>
        <VBox spacing="18" style="-fx-padding: 24 28;">

            <!-- FILTROS (opcionales, pero siguen el patrón de tus inputs) -->
            <HBox alignment="CENTER_LEFT" spacing="12">
                <Label text="Parqueadero:"
                       style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #4a5568;" />
                <ComboBox fx:id="cbParkingLot"
                          prefHeight="38" prefWidth="220"
                          promptText="Selecciona un parqueadero..."
                          style="-fx-background-color: #f7fafc;
                                 -fx-background-radius: 8;
                                 -fx-border-color: #cbd5e0;
                                 -fx-border-radius: 8;
                                 -fx-border-width: 1.5;
                                 -fx-padding: 8 14;
                                 -fx-font-size: 13px;" />

                <Region HBox.hgrow="ALWAYS" />

                <Button text="↻ Refrescar"
                        onAction="#onRefresh"
                        style="-fx-background-color: white;
                               -fx-text-fill: #4a5568;
                               -fx-font-size: 13px;
                               -fx-font-weight: 600;
                               -fx-background-radius: 8;
                               -fx-padding: 10 20;
                               -fx-cursor: hand;
                               -fx-border-color: #cbd5e0;
                               -fx-border-radius: 8;
                               -fx-border-width: 1.5;" />
            </HBox>

            <!-- 3 TARJETAS DE ESTADÍSTICAS -->
            <HBox spacing="18">
                <!-- Card 1 -->
                <VBox spacing="10" HBox.hgrow="ALWAYS"
                      style="-fx-background-color: white;
                             -fx-background-radius: 12;
                             -fx-padding: 18;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">
                    <Label text="Cliente que más veces ha parqueado"
                           style="-fx-font-size: 13px; -fx-font-weight: 700; -fx-text-fill: #2d3748;" />
                    <Label fx:id="lblTopClient"
                           text="—"
                           style="-fx-font-size: 20px; -fx-font-weight: 800; -fx-text-fill: #2d3748;" />
                    <Label fx:id="lblTopClientDetail"
                           text="Veces: 0"
                           style="-fx-font-size: 12px; -fx-text-fill: #718096;" />
                </VBox>

                <!-- Card 2 -->
                <VBox spacing="10" HBox.hgrow="ALWAYS"
                      style="-fx-background-color: white;
                             -fx-background-radius: 12;
                             -fx-padding: 18;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">
                    <Label text="Hora pico de ocupación"
                           style="-fx-font-size: 13px; -fx-font-weight: 700; -fx-text-fill: #2d3748;" />
                    <Label fx:id="lblPeakHour"
                           text="—"
                           style="-fx-font-size: 20px; -fx-font-weight: 800; -fx-text-fill: #2d3748;" />
                    <Label fx:id="lblPeakHourDetail"
                           text="Ocupación máx: 0%"
                           style="-fx-font-size: 12px; -fx-text-fill: #718096;" />
                </VBox>

                <!-- Card 3 -->
                <VBox spacing="10" HBox.hgrow="ALWAYS"
                      style="-fx-background-color: white;
                             -fx-background-radius: 12;
                             -fx-padding: 18;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">
                    <Label text="Espacio con mayor rotación"
                           style="-fx-font-size: 13px; -fx-font-weight: 700; -fx-text-fill: #2d3748;" />
                    <Label fx:id="lblMostRotatedSpace"
                           text="—"
                           style="-fx-font-size: 20px; -fx-font-weight: 800; -fx-text-fill: #2d3748;" />
                    <Label fx:id="lblMostRotatedSpaceDetail"
                           text="Entradas/Salidas: 0"
                           style="-fx-font-size: 12px; -fx-text-fill: #718096;" />
                </VBox>
            </HBox>

            <!-- DETALLE EN TABLA -->
            <VBox spacing="12">
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label text="Detalle"
                           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2d3748;" />
                    <Region HBox.hgrow="ALWAYS" />
                    <TextField fx:id="tfSearch"
                               prefHeight="38" prefWidth="260"
                               promptText="Buscar en el detalle..."
                               style="-fx-background-color: #f7fafc;
                                      -fx-background-radius: 8;
                                      -fx-border-color: #cbd5e0;
                                      -fx-border-radius: 8;
                                      -fx-border-width: 1.5;
                                      -fx-padding: 10 14;
                                      -fx-font-size: 13px;
                                      -fx-text-fill: #2d3748;" />
                </HBox>

                <TableView fx:id="tableDetail"
                           style="-fx-background-color: white;
                                  -fx-background-radius: 12;
                                  -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">
                    <columns>
                        <TableColumn fx:id="colKey" prefWidth="260" text="Métrica" />
                        <TableColumn fx:id="colValue" prefWidth="220" text="Valor" />
                        <TableColumn fx:id="colExtra" prefWidth="260" text="Detalle" />
                    </columns>
                </TableView>

                <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 6 0 0 0;">
                    <Label text="Total de filas:"
                           style="-fx-font-size: 12px; -fx-text-fill: #718096;" />
                    <Label fx:id="lblTotalRows"
                           text="0"
                           style="-fx-font-size: 12px; -fx-font-weight: 700; -fx-text-fill: #2d3748;" />
                </HBox>
            </VBox>

        </VBox>
    </center>
</BorderPane>
